[
  {"log": "--- Dropping files and pasting pictures: an image and a non-image file dropped, image data pasted twice (unique names in <document>.assets), and the save panel when pasting into an unsaved document"},
  {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72, "autoHideChrome": true, "spellCheck": false, "showFormattingToolbar": true}},
  {"open": "scripts/macos/ui/fixtures/tour.md", "folder": true},
  {"resize": [900, 980]},
  {"waitStyled": 20},
  {"command": "moveToEndOfDocument:", "edits": false},
  {"type": "\n\n"},
  {"dropFile": "scripts/macos/ui/fixtures/images/small.png"},
  {"assert": {"textContains": "![small]("}},
  {"type": "\n\n"},
  {"dropFile": "scripts/macos/ui/fixtures/markup.md"},
  {"assert": {"textContains": "[markup.md]("}},
  {"type": "\n\n"},
  {"pasteImage": "scripts/macos/ui/fixtures/images/small.png", "wait": 5},
  {"assert": {"pasted": true, "assets": 1, "textContains": "![image](tour.assets/image.png)"}},
  {"type": "\n\n"},
  {"pasteImage": "scripts/macos/ui/fixtures/images/tall.png", "wait": 5},
  {"assert": {"pasted": true, "assets": 2, "textContains": "image 2.png"}},
  {"type": "\n\nend"},
  {"waitStyled": 20},
  {"scroll": "end"},
  {"wait": 0.3},
  {"snapshot": "drop-paste-01-dropped-and-pasted"},
  {"assert": {"coreMatchesText": true}},
  {"log": "--- an unsaved document: pasting asks to save first, cancel aborts"},
  {"new": true},
  {"load": "Untitled with a relative picture:\n\n![rel](images/sample.png)\n\nend"},
  {"select": [0, 0]},
  {"waitStyled": 10},
  {"wait": 0.4},
  {"pasteImage": "scripts/macos/ui/fixtures/images/small.png", "wait": 1.5},
  {"assert": {"sheet": true}},
  {"sheet": "end"},
  {"wait": 0.5},
  {"assert": {"pasted": false, "sheet": false, "textLacks": "![image]"}}
]
