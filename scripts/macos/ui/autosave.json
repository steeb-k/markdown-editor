[
  {"log": "--- Autosave: a titled document is written 2 s after the last keystroke, never shows an edited dot, never asks on close"},
  {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72, "autoHideChrome": false, "spellCheck": false, "showFormattingToolbar": true}},
  {"open": "scripts/macos/ui/fixtures/tour.md", "folder": true},
  {"resize": [900, 700]},
  {"viewMode": "source"},
  {"waitStyled": 20},
  {"assert": {"windows": {"editedDot": false}, "documentEdited": false, "documentFile": {"lacks": "Autosaved. "}}},
  {"selectText": "Writing should feel calm", "offset": 0, "length": 0},
  {"type": "Autosaved. "},
  {"wait": 0.4},
  {"assert": {"windows": {"editedDot": false}, "documentEdited": true, "documentFile": {"lacks": "Autosaved. "}}},
  {"autosave": {"waitFile": "Autosaved. ", "minMs": 1200, "maxMs": 3500, "timeout": 8}},
  {"autosave": {"waitClean": true}},
  {"assert": {"windows": {"editedDot": false, "titleShown": true}, "documentEdited": false, "documentFile": {"contains": "Autosaved. ", "equalsText": true}, "titlebarClean": true}},
  {"snapshot": "01-saved-without-asking", "bitmap": true},

  {"log": "Typing that keeps going is written 2 s after its last keystroke, not before"},
  {"type": "wxyz", "interval": 0.9},
  {"assert": {"documentFile": {"lacks": "wxyz"}, "documentEdited": true}},
  {"autosave": {"waitFile": "wxyz", "minMs": 1000, "maxMs": 3500, "timeout": 8}},
  {"autosave": {"waitClean": true}},

  {"log": "An autosave leaves the undo stack alone: undo still takes the typing back, and the document is edited again until the next pause"},
  {"undoUntilLacks": "wxyz"},
  {"assert": {"textLacks": "wxyz", "documentEdited": true}},
  {"autosave": {"waitClean": true, "timeout": 8}},
  {"assert": {"documentFile": {"lacks": "wxyz", "contains": "Autosaved. ", "equalsText": true}, "documentEdited": false}},
  {"redoUntilContains": "wxyz"},
  {"assert": {"textContains": "wxyz"}},
  {"autosave": {"waitFile": "wxyz", "timeout": 8}},

  {"log": "Closing a window that has an edit not yet written writes it first, and asks nothing"},
  {"type": "closing edit"},
  {"assert": {"documentEdited": true}},
  {"autosave": {"closeWindow": true}},
  {"assert": {"sheet": false, "windows": {"count": 0, "documents": 0}, "documentFile": {"work": "tour.md", "contains": "closing edit"}}},

  {"log": "Another app's newer file is never overwritten: ours is kept in the history, the file is read again, and a bar says so"},
  {"open": "scripts/macos/ui/fixtures/tour.md", "folder": true},
  {"viewMode": "source"},
  {"waitStyled": 20},
  {"selectText": "Writing should feel calm", "offset": 0, "length": 0},
  {"type": "mine "},
  {"modifyOnDisk": {"append": "\nTheirs.\n", "coordinated": true}},
  {"wait": 0.8},
  {"assert": {"textContains": "Theirs.", "textLacks": "mine ", "documentEdited": false,
              "history": {"changeBar": true, "changeBarMentions": "kept in History", "messages": ["Before another app changed this file"], "reasons": ["pause", "pause"], "latestIsTheText": true}}},
  {"snapshot": "02-changed-by-another-app", "bitmap": true},
  {"history": {"show": true}},
  {"wait": 0.5},
  {"assert": {"history": {"panelShown": true}}},
  {"history": {"select": 1}},
  {"assert": {"history": {"diffContains": "mine "}}},
  {"snapshot": "03-ours-in-history", "bitmap": true},
  {"autosave": {"waitClean": true}},
  {"log": "A file nobody had edited here is simply read again, with the bar saying so"},
  {"modifyOnDisk": {"append": "More of theirs.\n", "coordinated": true}},
  {"wait": 0.8},
  {"assert": {"textContains": "More of theirs.", "history": {"changeBar": true, "changeBarMentions": "read again"}}},
  {"autosave": {"closeWindow": true}},

  {"log": "--- An untitled document with no library keeps the standard question on closing; with a library it becomes a draft"},
  {"new": true},
  {"type": "unsaved words"},
  {"autosave": {"closeWindow": true}},
  {"assert": {"sheet": true}},
  {"snapshot": "04-ask-to-keep", "window": "sheet"},
  {"sheet": "end"},
  {"assert": {"sheet": false, "windows": {"count": 1, "titles": ["Untitled"]}, "textContains": "unsaved words", "documentEdited": true}},
  {"wait": 2.6},
  {"assert": {"windows": {"titles": ["Untitled"]}, "textContains": "unsaved words"}},
  {"close": true},

  {"notes": {"setting": {"notesModeByDefault": true}}},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"new": true},
  {"notes": {"waitLoaded": 30}},
  {"type": "My first draft."},
  {"autosave": {"waitTitled": true, "timeout": 8}},
  {"autosave": {"waitClean": true}},
  {"assert": {"windows": {"titles": ["Untitled 1"], "editedDot": false}, "documentFile": {"work": "library/Drafts/Untitled 1.md", "contains": "My first draft.", "equalsText": true}}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"rowsContain": ["Drafts"], "selected": ["Drafts/Untitled 1.md"]}}},
  {"snapshot": "05-draft-in-the-sidebar", "bitmap": true},
  {"new": true},
  {"type": "Second draft."},
  {"autosave": {"closeWindow": true}},
  {"assert": {"sheet": false, "documentFile": {"work": "library/Drafts/Untitled 2.md", "contains": "Second draft."}}}
]
