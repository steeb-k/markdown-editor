[
 {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72, "autoHideChrome": false, "spellCheck": false}},

 {"log": "--- View > Line Width: the presets set the setting, the column follows, the menu checks the one that is true"},
 {"makeFile": {"name": "plain.md", "text": "# Plain\n\nA paragraph of the document, which has no front matter and takes the setting.\n"}},
 {"resize": [1400, 800]},
 {"waitStyled": 20},
 {"assert": {"measure": 72, "lineWidthMenu": {"setting": "Normal", "document": "Use Setting"}}},
 {"lineWidth": {"choose": "Narrow"}},
 {"wait": 0.2},
 {"assert": {"measure": 56, "lineWidthMenu": {"setting": "Narrow", "document": "Use Setting"}, "textEquals": "# Plain\n\nA paragraph of the document, which has no front matter and takes the setting.\n"}},
 {"lineWidth": {"choose": "Wide"}},
 {"wait": 0.2},
 {"assert": {"measure": 96, "lineWidthMenu": {"setting": "Wide"}}},
 {"lineWidth": {"choose": "Normal"}},
 {"wait": 0.2},
 {"assert": {"measure": 72, "lineWidthMenu": {"setting": "Normal"}}},
 {"log": "A setting that is none of the presets shows as Custom (N), checked"},
 {"setting": {"lineWidth": 80}},
 {"wait": 0.2},
 {"assert": {"measure": 80, "lineWidthMenu": {"setting": "Custom (80)"}}},
 {"setting": {"lineWidth": 72}},
 {"wait": 0.2},
 {"log": "The shortcuts, Control-Option-Command with -, 0 and ="},
 {"key": {"chars": "-", "mods": ["cmd", "control", "option"]}},
 {"wait": 0.2},
 {"assert": {"measure": 56, "lineWidthMenu": {"setting": "Narrow"}}},
 {"key": {"chars": "=", "mods": ["cmd", "control", "option"]}},
 {"wait": 0.2},
 {"assert": {"measure": 96, "lineWidthMenu": {"setting": "Wide"}}},
 {"key": {"chars": "0", "mods": ["cmd", "control", "option"]}},
 {"wait": 0.2},
 {"assert": {"measure": 72, "lineWidthMenu": {"setting": "Normal"}}},

 {"log": "--- This Document: a line_width: in the front matter, one undo step, whatever the setting says"},
 {"lineWidth": {"scope": "document", "choose": "Narrow"}},
 {"wait": 0.2},
 {"assert": {"textEquals": "---\nline_width: 56\n---\n\n# Plain\n\nA paragraph of the document, which has no front matter and takes the setting.\n", "measure": 56,
             "lineWidthMenu": {"setting": "Normal", "document": "Narrow"}}},
 {"lineWidth": {"choose": "Wide"}},
 {"wait": 0.2},
 {"assert": {"measure": 56, "lineWidthMenu": {"setting": "Wide", "document": "Narrow"}}},
 {"lineWidth": {"choose": "Normal"}},
 {"lineWidth": {"scope": "document", "choose": "Wide"}},
 {"wait": 0.2},
 {"assert": {"textContains": "line_width: 96\n", "textLacks": "line_width: 56", "measure": 96, "lineWidthMenu": {"document": "Wide"}}},
 {"undo": true},
 {"wait": 0.2},
 {"assert": {"textContains": "line_width: 56\n", "measure": 56, "lineWidthMenu": {"document": "Narrow"}}},
 {"undo": true},
 {"wait": 0.2},
 {"assert": {"textEquals": "# Plain\n\nA paragraph of the document, which has no front matter and takes the setting.\n", "measure": 72, "lineWidthMenu": {"document": "Use Setting"}}},
 {"redo": true},
 {"wait": 0.2},
 {"assert": {"textContains": "line_width: 56\n", "measure": 56}},

 {"log": "A key typed by hand moves the column, and so does one made odd"},
 {"selectText": "56"},
 {"type": "80"},
 {"wait": 0.2},
 {"assert": {"textContains": "line_width: 80\n", "measure": 80, "lineWidthMenu": {"document": "Custom (80)"}}},
 {"type": "x"},
 {"wait": 0.2},
 {"assert": {"textContains": "line_width: 80x\n", "measure": 72, "lineWidthMenu": {"document": "Use Setting"}}},
 {"command": "deleteBackward:"},
 {"wait": 0.2},
 {"assert": {"textContains": "line_width: 80\n", "measure": 80}},

 {"log": "Use Setting takes the key out, and the block with it when nothing else is in it"},
 {"lineWidth": {"scope": "document", "choose": "Use Setting"}},
 {"wait": 0.2},
 {"assert": {"textEquals": "# Plain\n\nA paragraph of the document, which has no front matter and takes the setting.\n", "measure": 72, "lineWidthMenu": {"document": "Use Setting"}}},
 {"close": true},

 {"log": "--- A key beside others, a quoted value, an out-of-range value"},
 {"makeFile": {"name": "keys.md", "text": "---\ntitle: T\nline_width: \"96\"\ntemplate: Academic\n---\n\nBody\n"}},
 {"resize": [1400, 800]},
 {"waitStyled": 20},
 {"assert": {"measure": 96, "lineWidthMenu": {"document": "Wide"}}},
 {"lineWidth": {"scope": "document", "choose": "Use Setting"}},
 {"wait": 0.2},
 {"assert": {"textEquals": "---\ntitle: T\ntemplate: Academic\n---\n\nBody\n", "measure": 72}},
 {"close": true},
 {"makeFile": {"name": "range.md", "text": "---\nline_width: 999\n---\n\nBody\n"}},
 {"resize": [1400, 800]},
 {"waitStyled": 20},
 {"assert": {"measure": 72, "lineWidthMenu": {"document": "Use Setting"}}},
 {"close": true},

 {"log": "--- Two windows: the setting moves both, a document's key only its own"},
 {"makeFile": {"name": "a.md", "text": "---\nline_width: 56\n---\n\nA\n"}},
 {"waitStyled": 20},
 {"makeFile": {"name": "b.md", "text": "B\n"}},
 {"resize": [1400, 800]},
 {"waitStyled": 20},
 {"wait": 0.3},
 {"assert": {"measure": 72}},
 {"lineWidth": {"choose": "Wide"}},
 {"wait": 0.3},
 {"assert": {"measure": 96}},
 {"switchTo": 0},
 {"wait": 0.3},
 {"assert": {"measure": 56, "lineWidthMenu": {"setting": "Wide", "document": "Narrow"}}},
 {"lineWidth": {"choose": "Normal"}},
 {"wait": 0.3},
 {"assert": {"measure": 56}},
 {"switchTo": 1},
 {"wait": 0.3},
 {"assert": {"measure": 72}},
 {"close": true},
 {"switchTo": 0},
 {"close": true}
]
