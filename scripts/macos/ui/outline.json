[
 {
  "log": "--- The outline in the side column: View > Side Column, in every layout, clicks jump the editor and the preview, the mark follows the scroll position (never the caret) and the page, keys, folding, the divider, notes mode, 1000 headings"
 },
 {
  "setting": {
   "theme": "light",
   "fontChoice": "iaQuattro",
   "fontSize": 17,
   "lineWidth": 72,
   "autoHideChrome": true,
   "chromeReturnsAfterPause": true,
   "spellCheck": false,
   "showFormattingToolbar": true,
   "centreFocusedLine": true
  }
 },
 {
  "open": "scripts/macos/ui/fixtures/outline.md",
  "folder": true
 },
 {
  "resize": [
   1100,
   760
  ]
 },
 {
  "viewMode": "source"
 },
 {
  "layout": "editor"
 },
 {
  "waitStyled": 20
 },
 {
  "selectText": "quick brown fox",
  "offset": 3
 },
 {
  "wait": 0.3
 },
 {
  "assert": {
   "outline": {
    "shown": false,
    "plain": true
   },
   "menu": {
    "View > Side Column": {
     "enabled": true,
     "state": "off"
    }
   }
  }
 },
 {
  "snapshot": "outline-00-off",
  "bitmap": true
 },
 {
  "log": "--- shown from the View menu"
 },
 {
  "outline": {
   "show": true
  }
 },
 {
  "outline": {
   "waitEntries": 14
  }
 },
 {
  "wait": 0.4
 },
 {
  "assert": {
   "outline": {
    "shown": true,
    "count": 14,
    "titles": [
     "Field notes",
     "First part",
     "Morning",
     "Afternoon",
     "Second part",
     "With emphasis and code and a link",
     "Deep one",
     "Setext heading",
     "A heading in a quote",
     "A heading in a list item",
     "Third part",
     "Evening",
     "Appendix",
     "Last words"
    ],
    "levels": [
     1,
     2,
     3,
     3,
     2,
     3,
     4,
     1,
     2,
     3,
     2,
     3,
     1,
     2
    ],
    "width": 260,
    "accessible": true,
    "marked": "Field notes"
   },
   "menu": {
    "View > Side Column": {
     "enabled": true,
     "state": "on"
    }
   }
  }
 },
