    }
   }
  }
 },
 {
  "action": "showLiveMode:",
  "edits": false
 },
 {
  "action": "toggleFocusMode:",
  "edits": false
 },
 {
  "action": "toggleSyntaxHighlight:",
  "edits": false
 },
 {
  "action": "showSplitLayout:",
  "edits": false
 },
 {
  "wait": 0.5
 },
 {
  "assert": {
