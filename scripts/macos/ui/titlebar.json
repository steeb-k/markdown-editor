 {
  "doubleClickTitlebar": {
   "x": 0.5
  }
 },
 {
  "snapshot": "04-after-double-click-faded",
  "bitmap": true
 },
 {
  "log": "(a pause: the chrome comes back 2.5 s after the last key, before the next typing, however fast the steps before ran)"
 },
 {
  "wait": 2.0
 },
 {
  "type": "More typing. ",
  "interval": 0.03
 },
 {
  "wait": 0.6
 },
 {
  "assert": {
   "chromeVisible": false
  }
 },
 {
  "doubleClickTitlebar": {
   "x": 0.3
  }
 },
 {
  "doubleClickTitlebar": {
   "x": 0.8
  }
 },
 {
  "log": "(and the pause after the second typing too: two returns by now, whatever the double-clicks' pace)"
 },
 {
  "wait": 2.6
 },
 {
  "pointer": "moved"
 },
 {
  "wait": 0.5
 },
 {
  "assert": {
   "chromeVisible": true,
   "titlebarClean": true,
   "chromeReturnsByPause": 2
  }
 },
 {
  "snapshot": "05-titlebar-after",
  "bitmap": true
 },
 {
  "log": "--- the chrome fades back in by itself after a pause in typing (2.5 s)"
 },
 {
  "type": "ab",
  "interval": 0.05
 },
 {
  "wait": 0.5
 },
 {
  "assert": {
   "chromeVisible": false
  }
 },
 {
  "wait": 1.0
 },
 {
  "assert": {
   "chromeVisible": false
  }
 },
 {
  "wait": 2.2
 },
 {
  "assert": {
   "chromeVisible": true,
   "chromeReturnsByPause": 3
  }
 },
 {
  "snapshot": "06-back-after-a-pause",
  "bitmap": true
 },
 {
  "log": "--- keys within the pause keep it hidden, however long they go on"
 },
 {
  "type": "abcd",
  "interval": 1.0
 },
 {
  "assert": {
   "chromeVisible": false,
   "chromeReturnsByPause": 3
  }
 },
 {
  "wait": 1.0
 },
 {
  "assert": {
   "chromeVisible": false
  }
 },
 {
  "wait": 1.0
 },
 {
  "assert": {
   "chromeVisible": true,
   "chromeReturnsByPause": 4
  }
 },
 {
  "log": "--- a pointer move first: no second fade-in when the pause ends"
 },
 {
  "type": "ab",
  "interval": 0.05
 },
 {
  "wait": 0.5
 },
 {
  "assert": {
   "chromeVisible": false
  }
 },
 {
  "pointer": "moved"
 },
 {
  "wait": 0.4
 },
 {
  "assert": {
   "chromeVisible": true
  }
 },
 {
  "wait": 3.0
 },
 {
  "assert": {
   "chromeVisible": true,
   "chromeReturnsByPause": 4
  }
 },
 {
  "log": "--- the setting off: the chrome stays hidden until the pointer moves"
 },
 {
  "setting": {
   "chromeReturnsAfterPause": false
  }
 },
 {
  "type": "ab",
  "interval": 0.05
 },
 {
  "wait": 3.2
 },
 {
  "assert": {
   "chromeVisible": false
  }
 },
 {
  "pointer": "moved"
 },
 {
  "wait": 0.4
 },
 {
  "assert": {
   "chromeVisible": true
  }
 },
 {
  "setting": {
   "chromeReturnsAfterPause": true
  }
 },
