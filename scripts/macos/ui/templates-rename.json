[
  {"setting": {"theme": "light", "autoHideChrome": false, "defaultTemplate": "Paper"}},
  {"open": "scripts/macos/ui/fixtures/template-plain.md", "folder": true},
  {"load": "---\ntemplate: paper\n---\n\nAn unsaved document outside the library.\n"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library-templates"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"notes": {"click": "Open.md", "command": true}},
  {"assert": {"notes": {"documentURLEndsWith": "Open.md"}, "textContains": "template: Paper"}},

  {"log": "A template of yours named Paper; renaming one nothing names asks nothing"},
  {"templatesWindow": "show"},
  {"templates": {"new": true}},
  {"templates": {"rename": "Paper"}},
  {"templates": {"answerUpdate": "none"}},
  {"assert": {"templates": {"selected": "Paper", "defaultTemplate": "Paper"}}},

  {"log": "Renamed to Thesis: three documents name Paper (the open note, the closed note, the unsaved document), the note naming Letter does not"},
  {"templates": {"rename": "Thesis"}},
  {"templates": {"answerUpdate": "leave", "expect": "Update 3 documents that use “Paper”?"}},
  {"assert": {"notes": {"file": {"path": "Closed.md", "contains": "template: \"paper\""}}, "textContains": "template: Paper",
              "templates": {"selected": "Thesis", "defaultTemplate": "Thesis"}}},
  {"snapshot": "templates-rename-left", "window": "templates"},

  {"log": "Back to Paper and Thesis again, this time answered Update"},
  {"templates": {"rename": "Paper"}},
  {"templates": {"answerUpdate": "none"}},
  {"templates": {"rename": "Thesis"}},
  {"templates": {"answerUpdate": "update", "expect": "Update 3 documents that use “Paper”?"}},
  {"assert": {"textContains": "template: Thesis", "textLacks": "template: Paper",
              "notes": {"file": {"path": "Closed.md", "contains": "template: Thesis", "lacks": "template: \"paper\""}}}},
  {"assert": {"notes": {"file": {"path": "Letter.md", "contains": "template: Letter", "lacks": "Thesis"}}}},
  {"assert": {"notes": {"file": {"path": "Plain.md", "lacks": "template"}}}},
  {"switchTo": 0},
  {"assert": {"textContains": "template: Thesis", "textLacks": "paper"}},
  {"snapshot": "templates-rename-updated", "window": "templates"},

  {"log": "Undo in the open note restores Paper"},
  {"switchTo": 1},
  {"assert": {"notes": {"documentURLEndsWith": "Open.md"}, "textContains": "template: Thesis"}},
  {"undo": true},
  {"assert": {"textContains": "template: Paper", "textLacks": "Thesis"}},

  {"log": "Deleting Thesis asks nothing and the setting goes back to Default"},
  {"assert": {"templates": {"defaultTemplate": "Thesis"}}},
  {"templates": {"select": "Thesis"}},
  {"templates": {"delete": true}},
  {"templates": {"answerUpdate": "none"}},
  {"assert": {"templates": {"defaultTemplate": "Default", "list": ["Academic", "Default", "Letter", "Typewriter"]}}}
]
