 },
 {
  "editorScroll": 0.5
 },
 {
  "wait": 0.4
 },
 {
  "assert": {
   "focusInsets": false,
   "preview": {
    "scrollSynced": 1
   }
  }
 },
 {
  "previewScroll": 0.3
 },
 {
  "wait": 0.4
 },
 {
  "assert": {
   "focusInsets": false,
   "preview": {
    "scrollSynced": 1
   },
   "overlayConsistent": true
  }
 },
 {
