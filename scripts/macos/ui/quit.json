[
  {"log": "--- Asking before quitting (M8g): the question appears with a window open and not without, Cancel leaves everything, the checkbox turns the preference off and Settings shows it"},
  {"setting": {"theme": "light", "autoHideChrome": false, "askBeforeQuitting": true, "reopenAtLaunch": true}},
  {"open": "scripts/macos/ui/fixtures/tour.md"},
  {"waitStyled": 20},
  {"assert": {"session": {"askBeforeQuitting": true, "quitDialogs": 0, "windows": 1}}},

  {"log": "Cancel: the question is asked once, and everything stays"},
  {"quit": {"answer": "cancel", "expectDialog": true}},
  {"assert": {"session": {"windows": 1, "quitDialogs": 1, "askBeforeQuitting": true,
                          "lastQuitDialog": {"message": "Quit Markdown?", "buttons": ["Quit", "Cancel"], "default": "Quit", "suppression": "Do not ask again", "windows": 1}},
              "textContains": "The quiet page"}},
  {"log": "The checkbox ticked and then Cancel changes nothing: the person did not quit"},
  {"quit": {"answer": "cancel", "suppress": true, "expectDialog": true}},
  {"assert": {"session": {"windows": 1, "quitDialogs": 2, "askBeforeQuitting": true}}},
  {"settingsWindow": "show"},
  {"wait": 0.5},
  {"snapshot": "settings-on", "window": "settings"},
  {"assert": {"session": {"settingsSwitches": [true, true]}}},
  {"settingsWindow": "hide"},

  {"log": "Quit with the checkbox ticked: the app quits, the window comes back, and the preference is off"},
  {"relaunch": {"suppress": true, "expectDialog": true}},
  {"waitStyled": 20},
  {"assert": {"session": {"windows": 1, "restored": 1, "askBeforeQuitting": false, "quitDialogs": 3}}},
  {"settingsWindow": "show"},
  {"wait": 0.5},
  {"snapshot": "settings-off", "window": "settings"},
  {"assert": {"session": {"settingsSwitches": [true, false]}}},
  {"settingsWindow": "hide"},

  {"log": "With the preference off, quitting with a window open asks nothing"},
  {"relaunch": {"expectDialog": false}},
  {"waitStyled": 20},
  {"assert": {"session": {"windows": 1, "restored": 1, "quitDialogs": 3}}},

  {"log": "With the preference on again and no window open, the app quits at once"},
  {"setting": {"askBeforeQuitting": true}},
  {"close": true},
  {"assert": {"session": {"windows": 0}}},
  {"relaunch": {"expectDialog": false}},
  {"assert": {"session": {"windows": 0, "quitDialogs": 3, "askBeforeQuitting": true}}},
  {"quit": {"answer": "quit", "expectDialog": false}}
]
