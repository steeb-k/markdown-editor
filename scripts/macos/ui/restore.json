[
  {"log": "--- Reopening where it left off (M8g): two windows with different layouts, modes, columns and scroll positions, one of them in Notes Mode on the library; relaunched through the normal quit; a missing file; the preference off; an untitled document's text"},
  {"setting": {"theme": "light", "autoHideChrome": false, "chromeReturnsAfterPause": false, "spellCheck": false, "reopenAtLaunch": true, "askBeforeQuitting": true}},
  {"assert": {"session": {"reopenAtLaunch": true, "askBeforeQuitting": true, "windows": 0}}},

  {"log": "An untitled document's text survives quit and relaunch (no library yet, so nothing drafts it into a file, and quitting asks nothing)"},
  {"new": true},
  {"type": "A page nobody saved\nsecond line"},
  {"waitStyled": 10},
  {"assert": {"session": {"windows": 1, "files": ["untitled"]}}},
  {"session": {"snapshot": "untitled"}},
  {"relaunch": {}},
  {"assert": {"session": {"restored": 1, "skipped": 0, "windows": 1, "files": ["untitled"], "untitledText": "A page nobody saved\nsecond line", "sameAs": "untitled"}}},
  {"close": true},
  {"assert": {"session": {"windows": 0}}},

  {"log": "Window A: the outline document, Live, Editor and Preview, the outline column, scrolled, a caret in the second part"},
  {"open": "scripts/macos/ui/fixtures/outline.md", "folder": true},
  {"resize": [1000, 700]},
  {"viewMode": "live"},
  {"layout": "split"},
  {"waitStyled": 20},
  {"column": {"toggle": true}},
  {"selectText": "Second part", "offset": 3},
  {"editorScroll": 0.45},
  {"wait": 0.6},
  {"assert": {"session": {"window": {"file": "outline.md", "layout": "split", "viewMode": "live", "notes": false, "column": {"shown": true, "pane": "outline"}}}}},

  {"log": "Window B: a note of the library in Notes Mode, a folder selected, sorted by date, History in the column, focus mode, Source"},
  {"open": "scripts/macos/ui/fixtures/live.md"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"resize": [900, 640]},
  {"viewMode": "source"},
  {"layout": "editor"},
  {"focus": {"on": true}},
  {"notes": {"expand": "Projects"}},
  {"notes": {"select": ["Projects"]}},
  {"notes": {"sort": "modified"}},
  {"column": {"showHistory": true}},
  {"waitStyled": 20},
  {"selectText": "```", "offset": 1},
  {"wait": 0.6},
  {"assert": {"session": {"window": {"file": "live.md", "layout": "editor", "viewMode": "source", "focus": true, "notes": true, "selection": ["library:Projects"], "sort": "modified", "column": {"shown": true, "pane": "history"}}}}},

  {"log": "A is in front, so it is the key window after the relaunch"},
  {"switchTo": 0},
  {"wait": 0.4},
  {"assert": {"session": {"windows": 2, "files": ["outline.md", "live.md"], "front": "outline.md"}}},
  {"session": {"snapshot": "before"}},
  {"relaunch": {}},

  {"log": "After the relaunch: the same two windows, the same front window, the same everything"},
  {"waitStyled": 20},
  {"wait": 1.0},
  {"assert": {"session": {"restored": 2, "skipped": 0, "windows": 2, "files": ["outline.md", "live.md"], "front": "outline.md", "sameAs": "before"}}},
  {"assert": {"session": {"window": {"file": "live.md", "layout": "editor", "viewMode": "source", "focus": true, "notes": true, "selection": ["library:Projects"], "sort": "modified", "column": {"shown": true, "pane": "history"}}}}},
  {"assert": {"session": {"window": {"file": "outline.md", "layout": "split", "viewMode": "live", "notes": false, "column": {"shown": true, "pane": "outline"}, "scrollCharacterAtLeast": 200}}}},
  {"snapshot": "restored-a"},

  {"log": "A file that has gone missing is skipped, with no dialog; the other window comes back as it was"},
  {"session": {"deleteFile": "outline.md"}},
  {"relaunch": {}},
  {"assert": {"session": {"restored": 1, "skipped": 1, "windows": 1, "files": ["live.md"], "front": "live.md"}}},
  {"assert": {"session": {"window": {"file": "live.md", "layout": "editor", "viewMode": "source", "focus": true, "notes": true, "selection": ["library:Projects"], "sort": "modified", "column": {"shown": true, "pane": "history"}}}}},

  {"log": "With the preference off nothing is restored: the app opens as it did before"},
  {"setting": {"reopenAtLaunch": false}},
  {"relaunch": {}},
  {"assert": {"session": {"windows": 0, "reopenAtLaunch": false}}},
  {"setting": {"reopenAtLaunch": true}}
]
