[
  {"log": "Code highlighting in the editor (M8c): colours from the theme, the language badge, its menu, Source and Live, themes, focus mode"},
  {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72}},
  {"open": "scripts/macos/ui/fixtures/code.md"},
  {"viewMode": "source"},
  {"resize": [900, 900]},
  {"waitStyled": 60},
  {"selectText": "Some prose before", "offset": 4},
  {"waitStyled": 30},
  {"assert": {"coreMatchesText": true, "code": {
    "badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"],
    "noBadge": "fn plain",
    "badgeAtTopRightOf": "fn main",
    "codeColours": [
      {"needle": "// Greets", "role": "comment"},
      {"needle": "fn main", "role": "keyword"},
      {"needle": "main()", "role": "function"},
      {"needle": "\"world\"", "role": "string"},
      {"needle": "42", "role": "number"},
      {"needle": "u32", "role": "keyword"},
      {"needle": "class Greeter", "role": "keyword"},
      {"needle": "# trailing", "role": "comment"},
      {"needle": "const greet", "role": "keyword"},
      {"needle": "fn plain", "role": "code"},
      {"needle": "fn nolanguage", "role": "code"},
      {"needle": "Some prose", "role": "text"},
      {"needle": "```rust", "role": "markup"}
    ]}}},
  {"snapshot": "code-01-source-light", "bitmap": true},
  {"scroll": "end"},
  {"wait": 0.3},
  {"snapshot": "code-02-source-light-end", "bitmap": true},
  {"scroll": -200},

  {"log": "themes: the colours and the badge follow"},
  {"setting": {"theme": "dark"}},
  {"waitStyled": 60},
  {"assert": {"theme": "dark", "coreMatchesText": true, "code": {"badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"], "codeColours": [
      {"needle": "fn main", "role": "keyword"}, {"needle": "42", "role": "number"}, {"needle": "// Greets", "role": "comment"}]}}},
  {"snapshot": "code-03-source-dark", "bitmap": true},
  {"setting": {"theme": "sepia"}},
  {"waitStyled": 60},
  {"assert": {"theme": "sepia", "code": {"codeColours": [{"needle": "fn main", "role": "keyword"}, {"needle": "\"world\"", "role": "string"}]}}},
  {"snapshot": "code-04-source-sepia", "bitmap": true},
  {"setting": {"theme": "light"}},
  {"waitStyled": 60},

  {"log": "the badge: a click opens the menu, a choice is one undoable edit on the info string"},
  {"selectText": "Some prose before", "offset": 4},
  {"codeBadge": {"click": "fn main"}},
  {"assert": {"textContains": "```rust\n// Greets", "code": {"codeMenu": {"first": "Rust", "checked": "Rust", "commonCount": 31, "last": "All", "allGroups": 25}}, "selection": [26, 0]}},
  {"codeBadge": {"click": "fn main", "choose": "Python"}},
  {"waitStyled": 30},
  {"assert": {"textContains": "```python\n// Greets", "textLacks": "```rust\n// Greets", "coreMatchesText": true, "edited": true,
    "code": {"badges": ["Python", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"],
             "codeColours": [{"needle": "use std", "role": "code"}, {"needle": "let name", "role": "code"}]}, "selection": [26, 0]}},
  {"snapshot": "code-05-chose-python", "bitmap": true},
  {"undo": true},
  {"waitStyled": 30},
  {"assert": {"textContains": "```rust\n// Greets", "textLacks": "```python\n// Greets", "coreMatchesText": true,
    "code": {"badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"], "codeColours": [{"needle": "fn main", "role": "keyword"}]}}},
  {"redo": true},
  {"waitStyled": 30},
  {"assert": {"textContains": "```python\n// Greets"}},
  {"undo": true},
  {"waitStyled": 30},

  {"log": "what follows the language stays: a choice in a fence with attributes"},
  {"codeBadge": {"click": "const greet", "choose": "TypeScript"}},
  {"waitStyled": 30},
  {"assert": {"textContains": "```ts title=\"greet.js\"\nconst greet", "code": {"badges": ["Rust", "Python", "TypeScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"]}}},
  {"codeBadge": {"click": "class Greeter", "choose": "ruby"}},
  {"waitStyled": 30},
  {"assert": {"textContains": "```ruby {.numberLines}\nclass Greeter"}},
  {"undo": true},
  {"undo": true},
  {"waitStyled": 30},
  {"assert": {"textContains": "```python {.numberLines}\nclass Greeter", "code": {"badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"]}}},

  {"log": "a block with no language, or an unknown one, has no badge; the way to give one is the info string"},
  {"assert": {"code": {"noBadge": "fn nolanguage", "badgesIgnoringCaret": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"]}}},
  {"selectText": "nosuchlanguage"},
  {"type": "rust"},
  {"waitStyled": 30},
  {"assert": {"textContains": "```rust\nfn plain", "code": {"badges": ["Rust", "Python", "JavaScript", "Rust", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"], "codeColours": [{"needle": "fn plain", "role": "keyword"}]}}},
  {"undoUntilContains": "nosuchlanguage"},
  {"waitStyled": 30},
  {"assert": {"textContains": "```nosuchlanguage\nfn plain", "code": {"noBadge": "fn plain"}}},

  {"log": "the caret never sits under the badge: a fence whose info string fills the line"},
  {"selectText": "let long_info"},
  {"assert": {"code": {"badgesIgnoringCaret": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"], "caretClearOfBadge": true}}},
  {"selectText": "ignore,edition2021", "offset": 0},
  {"assert": {"code": {"caretClearOfBadge": true}}},
  {"selectText": "should_panic,this_is", "offset": 12},
  {"waitStyled": 30},
  {"assert": {"code": {"caretClearOfBadge": true}}},
  {"snapshot": "code-06-caret-on-the-fence-line", "bitmap": true},
  {"command": "moveToEndOfLine:"},
  {"assert": {"code": {"badgeHiddenByCaret": "let long_info", "caretClearOfBadge": true}}},
  {"snapshot": "code-07-caret-at-the-end-of-a-long-fence-line", "bitmap": true},
  {"selectText": "let long_info"},
  {"assert": {"code": {"badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"], "caretClearOfBadge": true}}},

  {"log": "accessibility: a button per badge, Language: X, that performs press"},
  {"selectText": "Some prose before", "offset": 4},
  {"assert": {"code": {"accessibleBadges": ["Language: Rust", "Language: Python"], "pressAccessibleBadge": "Language: Python"}}},

  {"log": "Live mode: the fences are concealed and the badge stays at the block's top right"},
  {"viewMode": "live"},
  {"selectText": "Some prose before", "offset": 4},
  {"waitStyled": 30},
  {"wait": 0.3},
  {"scroll": -200},
  {"assert": {"viewMode": "live", "coreMatchesText": true, "code": {
    "badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"],
    "badgeAtTopRightOf": "fn main",
    "codeColours": [{"needle": "fn main", "role": "keyword"}, {"needle": "// Greets", "role": "comment"}],
    "fenceHidden": ["```rust", "```python {.numberLines}", "```js title=\"greet.js\""]}}},
  {"snapshot": "code-08-live-light", "bitmap": true},
  {"codeBadge": {"click": "fn main", "choose": "C"}},
  {"waitStyled": 30},
  {"wait": 0.3},
  {"assert": {"textContains": "```c\n// Greets", "code": {"badges": ["C", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"], "badgeAtTopRightOf": "fn main"}}},
  {"snapshot": "code-09-live-chose-c", "bitmap": true},
  {"undo": true},
  {"waitStyled": 30},
  {"assert": {"textContains": "```rust\n// Greets"}},
  {"selectText": "let count", "offset": 4},
  {"waitStyled": 30},
  {"wait": 0.3},
  {"assert": {"code": {"badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"], "badgeAtTopRightOf": "fn main", "caretClearOfBadge": true}}},
  {"snapshot": "code-10-live-caret-in-the-block", "bitmap": true},
  {"setting": {"theme": "dark"}},
  {"waitStyled": 60},
  {"selectText": "Some prose before", "offset": 4},
  {"waitStyled": 30},
  {"assert": {"theme": "dark", "code": {"codeColours": [{"needle": "fn main", "role": "keyword"}, {"needle": "\"world\"", "role": "string"}], "badgeAtTopRightOf": "fn main"}}},
  {"snapshot": "code-11-live-dark", "bitmap": true},
  {"setting": {"theme": "sepia"}},
  {"waitStyled": 60},
  {"snapshot": "code-12-live-sepia", "bitmap": true},
  {"setting": {"theme": "light"}},
  {"waitStyled": 60},

  {"log": "focus mode dims highlighted code with everything else"},
  {"focus": {"on": true, "scope": "paragraph"}},
  {"selectText": "Some prose before", "offset": 4},
  {"waitStyled": 30},
  {"wait": 0.4},
  {"assert": {"code": {"temporaryColour": {"needle": "fn main", "is": "focusDim"},
                       "codeColours": [{"needle": "fn main", "role": "keyword"}]}, "overlayConsistent": true}},
  {"snapshot": "code-13-live-focus-away-from-code", "bitmap": true},
  {"selectText": "let count", "offset": 4},
  {"waitStyled": 30},
  {"wait": 0.4},
  {"assert": {"code": {"temporaryColour": {"needle": "fn main", "is": "none"}}, "overlayConsistent": true}},
  {"snapshot": "code-14-live-focus-in-the-code", "bitmap": true},
  {"viewMode": "source"},
  {"selectText": "Some prose before", "offset": 4},
  {"waitStyled": 30},
  {"wait": 0.4},
  {"assert": {"code": {"temporaryColour": {"needle": "fn main", "is": "focusDim"}, "badges": ["Rust", "Python", "JavaScript", "Bourne Again Shell (bash)", "Go", "JSON", "Rust"]}, "overlayConsistent": true}},
  {"snapshot": "code-15-source-focus", "bitmap": true},
  {"focus": {"on": false}},
  {"wait": 0.3},
  {"assert": {"code": {"temporaryColour": {"needle": "fn main", "is": "none"}, "codeColours": [{"needle": "fn main", "role": "keyword"}]}}},

  {"log": "typing in a block keeps the colours of a fresh analysis"},
  {"selectText": "let count: u32 = 42;", "offset": 20},
  {"type": " // note\n    let more = \"x\";", "interval": 0.02},
  {"waitStyled": 60},
  {"assert": {"coreMatchesText": true, "code": {"codeColours": [{"needle": "// note", "role": "comment"}, {"needle": "let more", "role": "keyword"}, {"needle": "\"x\"", "role": "string"}]}}},
  {"snapshot": "code-16-typed", "bitmap": true}
]
