[
  {"setting": {"theme": "light", "autoHideChrome": false, "defaultViewMode": "source"}},

  {"log": "Plain mode: a wikilink is styled like a link; Cmd-click finds the note beside the document, or offers to make it"},
  {"open": "scripts/macos/ui/fixtures/library/Links.md", "folder": true},
  {"assert": {"notes": {"mode": false, "plainLayout": true}}},
  {"snapshot": "01-plain-wikilinks"},
  {"notes": {"cmdClickWikilink": "Why?", "expect": "external"}},
  {"assert": {"notes": {"externalOpened": "Why?.md"}}},
  {"notes": {"cmdClickWikilink": "Fifty%", "expect": "external"}},
  {"assert": {"notes": {"externalOpened": "Fifty%.md"}}},
  {"notes": {"cmdClickWikilink": "Note: Colon", "expect": "external"}},
  {"assert": {"notes": {"externalOpened": "Note- Colon.md"}}},
  {"notes": {"cmdClickWikilink": "Projects/Alpha|", "expect": "external"}},
  {"assert": {"notes": {"externalOpened": "Alpha.md"}}},
  {"notes": {"cmdClickWikilink": "Brand New Idea", "expect": "offer"}},
  {"snapshot": "02-offer-to-create", "window": "sheet"},
  {"sheet": "end"},
  {"assert": {"openDocuments": ["Links.md"]}},

  {"log": "Notes mode: the library resolves the link; the note replaces the window's document"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"notes": {"click": "Links.md"}},
  {"assert": {"windows": {"count": 1, "titles": ["Links.md"]}}},
  {"notes": {"cmdClickWikilink": "Gamma", "expect": "open"}},
  {"assert": {"windows": {"count": 1, "titles": ["Gamma.md"]}, "notes": {"documentURLEndsWith": "Projects/Gamma.md", "selected": ["Projects/Gamma.md"]}}},
  {"notes": {"click": "Links.md"}},
  {"notes": {"cmdClickWikilink": "Alpha#Goals", "expect": "open"}},
  {"wait": 0.3},
  {"assert": {"notes": {"documentURLEndsWith": "Projects/Alpha.md"}, "selection": [139, 0]}},
  {"notes": {"click": "Links.md"}},
  {"notes": {"cmdClickWikilink": "Why?", "expect": "open"}},
  {"assert": {"notes": {"documentURLEndsWith": "Why?.md"}, "textContains": "A note whose name has a question mark"}},
  {"notes": {"click": "Links.md"}},
  {"notes": {"cmdClickWikilink": "Note: Colon", "expect": "open"}},
  {"assert": {"notes": {"documentURLEndsWith": "Note- Colon.md"}}},

  {"log": "A link to a note that is not there offers to make it beside this one, and opens it"},
  {"notes": {"click": "Links.md"}},
  {"notes": {"cmdClickWikilink": "Brand New Idea", "expect": "offer"}},
  {"snapshot": "03-offer-in-notes-mode", "window": "sheet"},
  {"sheet": "accept"},
  {"wait": 0.8},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"file": {"path": "Brand New Idea.md", "exists": true, "equals": ""}, "documentURLEndsWith": "Brand New Idea.md", "rowsContain": ["Brand New Idea"]}}},

  {"log": "In the preview a click on a wikilink opens the note through the same path (names with % and ? included)"},
  {"notes": {"click": "Links.md"}},
  {"layout": "split"},
  {"waitPreview": 30},
  {"snapshot": "04-preview-wikilinks"},
  {"clickPreviewLink": "Why?"},
  {"wait": 0.8},
  {"assert": {"notes": {"documentURLEndsWith": "Why?.md"}}},
  {"notes": {"click": "Links.md"}},
  {"clickPreviewLink": "Fifty%"},
  {"wait": 0.8},
  {"assert": {"notes": {"documentURLEndsWith": "Fifty%.md"}}},
  {"notes": {"click": "Links.md"}},
  {"clickPreviewLink": "Note: Colon"},
  {"wait": 0.8},
  {"assert": {"notes": {"documentURLEndsWith": "Note- Colon.md"}}},
  {"notes": {"click": "Links.md"}},
  {"clickPreviewLink": "the alpha project"},
  {"wait": 0.8},
  {"assert": {"notes": {"documentURLEndsWith": "Projects/Alpha.md"}}},
  {"notes": {"click": "Links.md"}},
  {"clickPreviewLink": "Beta by path"},
  {"wait": 0.8},
  {"assert": {"notes": {"documentURLEndsWith": "Projects/Beta.md"}}},
  {"notes": {"click": "Links.md"}},
  {"layout": "editor"},

  {"log": "Tags and wikilinks in Live mode: the brackets and the target are concealed, the label shows"},
  {"viewMode": "live"},
  {"select": [0, 0]},
  {"snapshot": "05-live-wikilinks"},
  {"viewMode": "source"}
]
