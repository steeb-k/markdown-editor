[
  {"setting": {"theme": "light", "autoHideChrome": false}},
  {"open": "scripts/macos/ui/fixtures/library-mentions/Open.md", "folder": true},
  {"notes": {"library": "scripts/macos/ui/fixtures/library-mentions"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},

  {"log": "Notes that name Target by its title, its stem and its alias, in any case, are listed; a name in a code span or in a link is not"},
  {"notes": {"click": "Open.md"}},
  {"notes": {"click": "Target.md", "command": true}},
  {"notes": {"showBacklinks": true}},
  {"wait": 0.8},
  {"assert": {"windows": {"count": 2}, "notes": {"backlinksShown": true, "backlinks": ["Skips"],
              "mentions": [{"title": "Alias Note", "name": "QG patch"}, {"title": "Closed Note", "name": "Target"}, {"title": "Open Note", "name": "Quantum Garden"}]}}},
  {"snapshot": "01-mentions"},

  {"log": "A click on a row opens the note with the matched text selected"},
  {"notes": {"openMention": 1}},
  {"assert": {"notes": {"documentURLEndsWith": "Closed.md"}}},
  {"notes": {"click": "Target.md"}},
  {"wait": 0.8},

  {"log": "Link on a note that is open: one undo step in its window; the row moves to Backlinks"},
  {"notes": {"linkMention": 2}},
  {"assert": {"notes": {"backlinks": ["Open Note", "Skips"],
              "mentions": [{"title": "Alias Note", "name": "QG patch"}, {"title": "Closed Note", "name": "Target"}]}}},
  {"snapshot": "02-linked-open"},
  {"notes": {"click": "Open.md"}},
  {"assert": {"textContains": "the [[Target|quantum garden]] yesterday"}},
  {"undo": true},
  {"assert": {"textContains": "the quantum garden yesterday", "textLacks": "[["}},
  {"notes": {"click": "Target.md"}},
  {"wait": 0.8},
  {"assert": {"notes": {"backlinks": ["Skips"],
              "mentions": [{"title": "Alias Note", "name": "QG patch"}, {"title": "Closed Note", "name": "Target"}, {"title": "Open Note", "name": "Quantum Garden"}]}}},

  {"log": "Link on notes that are closed: their files are rewritten, and the rows move to Backlinks"},
  {"notes": {"linkMention": 1}},
  {"assert": {"notes": {"file": {"path": "Closed.md", "contains": "See [[target]] for details."}, "backlinks": ["Closed Note", "Skips"],
              "mentions": [{"title": "Alias Note", "name": "QG patch"}, {"title": "Open Note", "name": "Quantum Garden"}]}}},
  {"notes": {"linkMention": 0}},
  {"assert": {"notes": {"file": {"path": "Alias.md", "contains": "Try the [[Target|QG PATCH]] now."}, "backlinks": ["Alias Note", "Closed Note", "Skips"],
              "mentions": [{"title": "Open Note", "name": "Quantum Garden"}]}}},
  {"snapshot": "03-linked-closed"}
]
