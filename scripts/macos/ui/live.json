  "selectText": "The end",
  "offset": 3,
  "length": 0
 },
 {
  "clickCheckbox": 0
 },
 {
  "wait": 0.2
 },
 {
  "assert": {
   "textContains": "- [x] An open task"
  }
 },
 {
  "snapshot": "10-after-checkbox"
 },
