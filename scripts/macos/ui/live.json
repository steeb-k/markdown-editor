[
 {
  "log": "--- Live mode tour: prose, then the caret enters each construct"
 },
 {
  "setting": {
   "theme": "light",
   "fontChoice": "iaQuattro",
   "fontSize": 17,
   "lineWidth": 72,
   "autoHideChrome": true,
   "spellCheck": false,
   "showFormattingToolbar": true
  }
 },
 {
  "open": "scripts/macos/ui/fixtures/live.md",
  "folder": true
 },
 {
  "resize": [
   900,
   980
  ]
 },
 {
  "viewMode": "live"
 },
 {
  "selectText": "Writing should feel",
  "offset": 20,
  "length": 0
 },
 {
  "waitStyled": 20
 },
 {
  "waitImages": 5
 },
 {
  "wait": 0.4
 },
 {
  "assert": {
   "viewMode": "live",
   "coreMatchesText": true,
   "edited": false
  }
 },
 {
  "snapshot": "01-live-prose"
 },
 {
  "assert": {
   "decorations": {
