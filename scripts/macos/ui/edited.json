[
 {
  "log": "--- A titled document shows \"Edited\" only for the two seconds before the autosave (AppKit's own title kept it, so the title is the app's now): examples/Showcase.md, in plain mode and in notes mode with the library prompt showing, in every layout and in Source and Live"
 },
 {
  "setting": {
   "theme": "light",
   "fontChoice": "iaQuattro",
   "fontSize": 17,
   "lineWidth": 72,
   "autoHideChrome": false,
   "spellCheck": false,
   "showFormattingToolbar": true
  }
 },
 {
  "open": "examples/Showcase.md",
  "folder": true
 },
 {
  "resize": [
   1000,
   720
  ]
 },
 {
  "waitStyled": 20
 },
 {
  "assert": {
   "documentEdited": false,
   "windows": {
    "editedDot": false,
    "titleShown": true,
    "title": "Showcase.md"
   },
   "titlebarClean": true,
   "title": {
    "inPane": true,
    "edited": false,
    "text": "Showcase.md",
    "systemHidden": true
   }
  }
 },
 {
  "layout": "editor"
 },
 {
  "viewMode": "source"
 },
 {
  "waitStyled": 20
 },
 {
  "selectText": "every element",
  "offset": 0,
  "length": 0
 },
 {
  "type": "PlainEditorSource ",
  "interval": 0.04
 },
 {
  "wait": 0.4
 },
 {
  "assert": {
   "documentEdited": true,
   "title": {
    "inPane": true,
    "edited": true
   },
   "titlebarClean": true
  }
 },
 {
  "wait": 3.2
 },
 {
  "assert": {
   "documentEdited": false,
   "windows": {
    "editedDot": false
   },
   "documentFile": {
    "contains": "PlainEditorSource",
    "equalsText": true
   },
   "title": {
    "inPane": true,
    "edited": false,
    "text": "Showcase.md",
    "systemHidden": true
   },
   "titlebarClean": true
  }
 },
 {
  "snapshot": "edited-plain-editor-source",
  "bitmap": true
 },
