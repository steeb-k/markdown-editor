[
  {"log": "--- History: snapshots after a pause in typing, in a store of the script's own (plain files, an index), for a document outside any library"},
  {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72, "autoHideChrome": false, "spellCheck": false, "showFormattingToolbar": true}},
  {"open": "scripts/macos/ui/fixtures/tour.md", "folder": true},
  {"resize": [1000, 760]},
  {"viewMode": "source"},
  {"waitStyled": 20},
  {"history": {"key": true}},
  {"assert": {"history": {"count": 0}}},
  {"selectText": "Writing should feel calm", "offset": 0, "length": 0},
  {"type": "First pause. "},
  {"wait": 0.5},
  {"assert": {"history": {"count": 0}, "documentEdited": true}},
  {"history": {"waitVersions": 2, "timeout": 6}},
  {"autosave": {"waitClean": true}},
  {"assert": {"history": {"count": 2, "reasons": ["pause", "close"], "latestIsTheText": true, "store": true, "latestSummary": "+1 −1"},
              "documentFile": {"contains": "First pause. ", "equalsText": true}}},

  {"log": "Typing again, and pausing, takes a second; a pause that changed nothing takes none"},
  {"type": "Second. "},
  {"history": {"waitVersions": 3, "timeout": 6}},
  {"assert": {"history": {"count": 3, "reasons": ["pause", "pause", "close"], "latestIsTheText": true, "textOfVersion": {"index": 1, "contains": "First pause. ", "lacks": "Second. "}}}},
  {"type": "z"},
  {"undoUntilLacks": "zWriting"},
  {"wait": 3.2},
  {"assert": {"history": {"count": 3, "latestIsTheText": true}, "documentEdited": false}},

  {"log": "Save (Command-S) saves now and records a snapshot with the reason save, before the pause"},
  {"type": "Saved now. "},
  {"action": "saveDocument:", "edits": false},
  {"history": {"waitVersions": 4, "timeout": 1.5}},
  {"autosave": {"waitClean": true}},
  {"assert": {"history": {"count": 4, "latestReason": "save", "latestIsTheText": true}, "documentFile": {"contains": "Saved now. ", "equalsText": true}}},

  {"log": "Closing and opening the file again shows the versions, newest first, grouped by day"},
  {"reopen": true},
  {"waitStyled": 20},
  {"history": {"show": true}},
  {"wait": 0.6},
  {"assert": {"history": {"count": 4, "panelShown": true, "rows": 4, "days": ["Today"], "selected": false, "accessibleRows": true, "outlineHidden": true},
              "menu": {"View > History": {"state": "on"}}}},
  {"snapshot": "01-history-panel", "bitmap": true},

  {"log": "A row shows what changed since then: removed lines in the theme's reference colour, added lines in the AI colour"},
  {"history": {"select": 3}},
  {"assert": {"history": {"selected": true, "diffContains": "First pause. ", "diffColours": true}}},
  {"snapshot": "02-history-diff-oldest", "bitmap": true},
  {"history": {"select": 0}},
  {"assert": {"history": {"selected": true, "diffLacks": "First pause. "}}},

  {"log": "Copy puts the version's text on the pasteboard (one of the script's own)"},
  {"history": {"select": 2}},
  {"history": {"copy": true}},
  {"assert": {"history": {"copiedIsVersion": 2}}},

  {"log": "Restore records the text as it is, then applies the version's text as one undoable edit, \"Restore Version\", and records that too"},
  {"type": "Unsaved. "},
  {"assert": {"textContains": "Unsaved. ", "documentEdited": true}},
  {"history": {"select": 3}},
  {"history": {"restore": true}},
  {"assert": {"history": {"undoName": "Restore Version", "reasons": ["restore", "restore", "save"], "messages": ["Before restoring a version"]}, "textLacks": "First pause. "}},
  {"history": {"waitVersions": 6, "timeout": 4}},
  {"wait": 2.6},
  {"assert": {"history": {"count": 6, "latestIsTheText": true, "rows": 6}, "documentFile": {"lacks": "First pause. ", "equalsText": true}}},
  {"snapshot": "03-after-restore", "bitmap": true},
  {"undo": true},
  {"assert": {"textContains": "First pause. "}},
  {"wait": 2.6},
  {"assert": {"history": {"count": 7, "latestReason": "pause", "latestIsTheText": true}}},

  {"log": "The history and the outline share the column: showing one hides the other, and each comes back"},
  {"outline": {"show": true}},
  {"assert": {"history": {"panelShown": false}, "outline": {"shown": true}, "menu": {"View > History": {"state": "off"}, "View > Outline": {"state": "on"}}}},
  {"history": {"show": true}},
  {"assert": {"history": {"panelShown": true, "outlineHidden": true}, "outline": {"shown": false}, "menu": {"View > History": {"state": "on"}, "View > Outline": {"state": "off"}}}},
  {"history": {"show": false}},
  {"assert": {"history": {"panelShown": false}, "outline": {"plain": true}}},

  {"log": "--- In the library the history is the note's: it follows a rename, and a draft made from an untitled window has its first snapshot"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"notes": {"click": "Snippets.md"}},
  {"viewMode": "source"},
  {"select": [0, 0]},
  {"type": "In the library. "},
  {"history": {"waitVersions": 2, "timeout": 6}},
  {"autosave": {"waitClean": true}},
  {"assert": {"history": {"count": 2, "reasons": ["pause", "close"], "latestIsTheText": true, "store": true}}},
  {"history": {"key": true}},
  {"notes": {"rename": {"path": "Snippets.md", "to": "Clips"}}},
  {"sheet": "accept"},
  {"notes": {"settle": 10}},
  {"assert": {"windows": {"titles": ["Clips.md"]}, "history": {"count": 2, "reasons": ["pause", "close"], "latestIsTheText": true, "store": true}}},
  {"history": {"key": true}},
  {"history": {"show": true}},
  {"wait": 0.6},
  {"assert": {"history": {"rows": 2, "panelShown": true}}},
  {"history": {"show": false}},

  {"notes": {"setting": {"notesModeByDefault": true}}},
  {"new": true},
  {"wait": 0.5},
  {"notes": {"waitLoaded": 30}},
  {"type": "A draft that was never saved."},
  {"autosave": {"waitTitled": true, "timeout": 8}},
  {"history": {"waitVersions": 1, "timeout": 4}},
  {"assert": {"windows": {"titles": ["Untitled 1", "Clips.md"]}, "history": {"count": 1, "reasons": ["draft"], "latestIsTheText": true},
              "documentFile": {"work": "library/Drafts/Untitled 1.md", "contains": "A draft that was never saved.", "equalsText": true}}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"rowsContain": ["Drafts"]}}},
  {"history": {"show": true}},
  {"wait": 0.5},
  {"assert": {"history": {"rows": 1, "panelShown": true}}},
  {"snapshot": "04-draft-history", "bitmap": true}
]
