[
  {"setting": {"theme": "light", "autoHideChrome": false, "defaultViewMode": "source"}},
  {"open": "scripts/macos/ui/fixtures/tour.md"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"assert": {"menu": {"Library > Quick Open…": {"enabled": true}}}},

  {"log": "The palette: type, arrow, Return; fuzzy on titles and paths"},
  {"action": "quickOpen:", "edits": false},
  {"assert": {"palette": {"open": true, "fieldFocused": true}}},
  {"palette": {"type": "alp"}},
  {"assert": {"palette": {"first": "Alpha Project", "selected": 0, "maxRows": 12}}},
  {"snapshot": "01-quick-open"},
  {"palette": {"key": "down"}},
  {"assert": {"palette": {"selected": 1}}},
  {"palette": {"key": "up"}},
  {"assert": {"palette": {"selected": 0}}},
  {"palette": {"choose": true}},
  {"assert": {"palette": {"open": false}, "tabs": {"count": 2, "titles": ["tour.md", "Alpha.md"], "selected": 1},
              "notes": {"documentURLEndsWith": "Projects/Alpha.md", "selected": ["Projects/Alpha.md"]}}},

  {"action": "quickOpen:", "edits": false},
  {"palette": {"type": "cafsoc"}},
  {"assert": {"palette": {"first": "Café Society"}}},
  {"palette": {"type": "projbeta"}},
  {"assert": {"palette": {"first": "Beta"}}},
  {"snapshot": "02-quick-open-by-path"},
  {"palette": {"type": ""}},
  {"assert": {"palette": {"maxRows": 12}}},
  {"palette": {"type": "zzzqqq", "expectEmpty": true}},
  {"assert": {"palette": {"maxRows": 0}}},
  {"palette": {"key": "escape"}},
  {"assert": {"palette": {"open": false}, "tabs": {"count": 2}}},

  {"log": "Return on a note that is open brings its tab forward; Option-Return replaces the current tab"},
  {"action": "quickOpen:", "edits": false},
  {"palette": {"type": "home"}},
  {"palette": {"choose": true}},
  {"assert": {"tabs": {"count": 3, "titles": ["tour.md", "Alpha.md", "Home.md"], "selected": 2}}},
  {"action": "quickOpen:", "edits": false},
  {"palette": {"type": "alpha"}},
  {"palette": {"choose": true}},
  {"assert": {"tabs": {"count": 3, "selected": 1}}},
  {"action": "quickOpen:", "edits": false},
  {"palette": {"type": "inbox"}},
  {"palette": {"choose": true, "option": true}},
  {"assert": {"tabs": {"count": 3, "titles": ["tour.md", "Inbox.md", "Home.md"], "selected": 1}, "textContains": "Things to sort out"}},

  {"log": "The key equivalent toggles it; the editor has the keyboard again afterwards"},
  {"action": "quickOpen:", "edits": false},
  {"assert": {"palette": {"open": true}}},
  {"action": "quickOpen:", "edits": false},
  {"assert": {"palette": {"open": false}}},
  {"select": [0, 0]},
  {"type": "y"},
  {"assert": {"textContains": "y# Inbox"}}
]
