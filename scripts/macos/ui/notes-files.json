[
  {"setting": {"theme": "light", "autoHideChrome": false}},
  {"open": "scripts/macos/ui/fixtures/tour.md"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"notes": {"expand": "Projects"}},

  {"log": "New Note: Untitled.md in the selected folder, opened in the window (the document it had is saved first), named in the sidebar"},
  {"notes": {"select": ["Projects"]}},
  {"notes": {"newNote": true}},
  {"assert": {"windows": {"count": 1, "titles": ["Untitled.md"], "documents": 1},
              "notes": {"renaming": true, "documentURLEndsWith": "Projects/Untitled.md", "file": {"path": "Projects/Untitled.md", "exists": true}}}},
  {"snapshot": "01-new-note-renaming"},
  {"notes": {"commitRename": "Untitled"}},
  {"notes": {"newNote": true}},
  {"assert": {"notes": {"renaming": true, "documentURLEndsWith": "Projects/Untitled 2.md"}, "windows": {"count": 1}}},
  {"notes": {"commitRename": "Delta"}},
  {"notes": {"settle": 10}},
  {"assert": {"windows": {"titles": ["Delta.md"]},
              "notes": {"renaming": false, "documentURLEndsWith": "Projects/Delta.md", "selected": ["Projects/Delta.md"],
                        "file": {"path": "Projects/Untitled 2.md", "exists": false}, "rowsContain": ["Delta", "Untitled"]}}},
  {"type": "Delta says hello."},
  {"notes": {"settle": 10}},

  {"log": "Rename a note that others link to: Update 9 links in 9 notes?, applied through the open documents (one undo each) and to the files of the closed ones"},
  {"notes": {"click": "Home.md", "command": true}},
  {"notes": {"click": "Projects/Beta.md", "command": true}},
  {"notes": {"click": "Projects/Alpha.md", "command": true}},
  {"assert": {"windows": {"count": 4, "titles": ["Alpha.md", "Beta.md", "Home.md", "Delta.md"]}}},
  {"notes": {"rename": {"path": "Projects/Alpha.md", "to": "Omega"}}},
  {"assert": {"sheet": true}},
  {"snapshot": "02-link-update-question", "window": "sheet"},
  {"sheet": "accept"},
  {"notes": {"settle": 15}},
  {"assert": {"notes": {"documentURLEndsWith": "Projects/Omega.md", "selected": ["Projects/Omega.md"],
                        "file": {"path": "Projects/Alpha.md", "exists": false}},
              "textContains": "[[Omega#Goals]]"}},
  {"notes": {"click": "Home.md"}},
  {"assert": {"textContains": "[[Projects/Omega|alpha project]]", "textLacks": "Projects/Alpha"}},
  {"undo": true},
  {"assert": {"textContains": "[[Projects/Alpha|alpha project]]", "textLacks": "Omega"}},
  {"redo": true},
  {"assert": {"textContains": "[[Projects/Omega|alpha project]]"}},
  {"notes": {"click": "Projects/Beta.md"}},
  {"assert": {"textContains": "[[Omega]]", "textLacks": "[[Alpha]]"}},
  {"undo": true},
  {"assert": {"textContains": "[[Alpha]]"}},
  {"notes": {"settle": 15}},
  {"assert": {"notes": {"file": {"path": "Inbox.md", "contains": "[[Omega]] and [[Omega#Goals]]", "lacks": "[[Alpha"},
                        "backlinksContain": []}}},
  {"notes": {"showBacklinks": true}},
  {"snapshot": "03-after-rename"},
  {"notes": {"showBacklinks": false}},

  {"log": "Cancelling the question changes nothing; a rename nobody links to just happens"},
  {"notes": {"rename": {"path": "Projects/Gamma.md", "to": "Zeta"}}},
  {"assert": {"sheet": true}},
  {"sheet": "end"},
  {"notes": {"settle": 5}},
  {"assert": {"notes": {"file": {"path": "Projects/Gamma.md", "exists": true}}}},
  {"assert": {"notes": {"file": {"path": "Projects/Zeta.md", "exists": false}}}},
  {"notes": {"rename": {"path": "plain.txt", "to": "plain two"}}},
  {"assert": {"sheet": false}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"file": {"path": "plain two.txt", "exists": true}}}},
  {"assert": {"notes": {"file": {"path": "plain.txt", "exists": false}}}},

  {"log": "Folders: a new one, renamed; dragged notes move; files dropped from Finder are copied in"},
  {"notes": {"select": [""]}},
  {"notes": {"newFolder": true}},
  {"snapshot": "04-new-folder-renaming"},
  {"notes": {"commitRename": "Scratch"}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"folder": {"path": "", "contains": ["Scratch"]}, "rowsContain": ["Scratch"]}}},
  {"notes": {"move": {"path": "Snippets.md", "into": "Scratch"}}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"file": {"path": "Scratch/Snippets.md", "exists": true}}}},
  {"assert": {"notes": {"file": {"path": "Snippets.md", "exists": false}}}},
  {"notes": {"dropFromFinder": {"from": "scripts/macos/ui/fixtures/focus.md", "into": "Scratch"}}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"file": {"path": "Scratch/focus.md", "exists": true}}}},
  {"notes": {"rename": {"path": "Deep", "to": "Deeper"}}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"file": {"path": "Deeper/Nested/Folders/Deep Note.md", "exists": true}, "library": {"noteCount": 37}}}},
  {"notes": {"duplicate": "Home.md"}},
  {"assert": {"notes": {"file": {"path": "Home 2.md", "exists": true}}}},
  {"notes": {"reveal": "Home.md"}},

  {"log": "Move to Trash: never unlinked; a note that is open closes its window"},
  {"notes": {"click": "Escapes.md"}},
  {"assert": {"openDocuments": ["Delta.md", "Escapes.md", "Home.md", "Omega.md"], "windows": {"count": 4}}},
  {"notes": {"trash": "Escapes.md"}},
  {"assert": {"notes": {"trashed": true, "file": {"path": "Escapes.md", "exists": false}}, "windows": {"count": 3}, "openDocuments": ["Delta.md", "Home.md", "Omega.md"]}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"rowsLack": ["Escapes"]}}},

  {"log": "Templates: placeholders filled in, the caret where {{cursor}} was"},
  {"notes": {"select": [""]}},
  {"notes": {"newFromTemplate": "Meeting"}},
  {"assert": {"textContains": "# Meeting $ISODATE\n\nAttendees:\n\n", "textLacks": "{{", "selection": [34, 0],
              "notes": {"renaming": true, "documentURLEndsWith": "Meeting.md"}}},
  {"snapshot": "05-from-template"},
  {"notes": {"commitRename": "Meeting"}},

  {"log": "Today's note: made once from Templates/Daily.md, then found"},
  {"notes": {"todaysNote": true}},
  {"assert": {"documentURLEndsWith": "Daily/$TODAY.md", "textContains": "# $TODAY\n\nDate: $ISODATE\nTime: ", "textLacks": "{{cursor}}",
              "notes": {"folder": {"path": "Daily", "count": 1, "contains": ["$TODAY.md"]}, "documentURLEndsWith": "Daily/$TODAY.md"}}},
  {"snapshot": "06-todays-note"},
  {"type": "Written today."},
  {"notes": {"todaysNote": true}},
  {"assert": {"notes": {"folder": {"path": "Daily", "count": 1}}, "textContains": "Written today."}},
  {"notes": {"settle": 10}},
  {"assert": {"notes": {"rowsContain": ["Daily"]}}}
]
