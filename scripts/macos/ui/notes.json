[
  {"setting": {"theme": "light", "autoHideChrome": false, "defaultViewMode": "source"}},
  {"open": "scripts/macos/ui/fixtures/tour.md"},
  {"assert": {"notes": {"mode": false, "plainLayout": true, "sidebarShown": false}}},

  {"log": "Notes mode on: the sidebar beside the editor, the library scanned off the main thread"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"wait": 0.4},
  {"snapshot": "01-notes-mode"},
  {"assert": {"notes": {"mode": true, "sidebarShown": true, "plainLayout": false,
    "rowsStart": ["library", "Archive", "Attachments", "Deep", "Journal", "Notes", "Projects", "Templates", "Æther"],
    "rowsContain": ["Tags", "#project", "#idea"], "library": {"noteCount": 34}}}},

  {"log": "Clicking a note opens it as a tab of the group; clicking it again brings its tab forward"},
  {"notes": {"expand": "Projects"}},
  {"notes": {"click": "Projects/Alpha.md"}},
  {"assert": {"tabs": {"count": 2, "titles": ["tour.md", "Alpha.md"], "selected": 1, "nativeBarVisible": false, "stripShown": true},
              "notes": {"sidebarShown": true, "sameWorkspace": true, "selected": ["Projects/Alpha.md"], "documentURLEndsWith": "Projects/Alpha.md"},
              "textContains": "# Alpha Project"}},
  {"notes": {"click": "Home.md"}},
  {"assert": {"tabs": {"count": 3, "titles": ["tour.md", "Alpha.md", "Home.md"], "selected": 2}, "notes": {"selected": ["Home.md"]}, "textContains": "Welcome. Start with"}},
  {"notes": {"click": "Projects/Alpha.md"}},
  {"assert": {"tabs": {"count": 3, "selected": 1}, "notes": {"selected": ["Projects/Alpha.md"], "documentURLEndsWith": "Projects/Alpha.md", "openDocuments": ["tour.md", "Alpha.md", "Home.md"]}}},
  {"snapshot": "02-three-tabs"},

  {"log": "Option-click replaces the current tab's document; a titled document is saved in place first (autosave), an untitled one asks"},
  {"log": "A tab switch changes nothing in the sidebar but which row is selected (measured on the pixels)"},
  {"notes": {"probeTabSwitch": {"to": 0}}},
  {"notes": {"probeTabSwitch": {"to": 2}}},
  {"notes": {"probeTabSwitch": {"to": 1}}},
  {"notes": {"click": "Inbox.md", "option": true}},
  {"assert": {"tabs": {"count": 3, "titles": ["tour.md", "Inbox.md", "Home.md"], "selected": 1}, "notes": {"documentURLEndsWith": "Inbox.md", "selected": ["Inbox.md"]}, "textContains": "Things to sort out"}},
  {"select": [0, 0]},
  {"type": "x"},
  {"assert": {"edited": true}},
  {"notes": {"click": "Notes.md", "option": true}},
  {"wait": 0.6},
  {"assert": {"tabs": {"count": 3, "titles": ["tour.md", "Notes.md", "Home.md"], "selected": 1}, "textContains": "The top-level notes page",
              "notes": {"file": {"path": "Inbox.md", "contains": "x# Inbox"}, "openDocuments": ["tour.md", "Notes.md", "Home.md"]}}},
  {"newTab": true},
  {"type": "a draft"},
  {"assert": {"tabs": {"count": 4, "selected": 2, "titles": ["tour.md", "Notes.md", "Untitled", "Home.md"]}, "notes": {"sameWorkspace": true, "sidebarShown": true}}},
  {"notes": {"click": "Self.md", "option": true}},
  {"wait": 0.5},
  {"assert": {"sheet": true}},
  {"snapshot": "03-save-first", "window": "sheet"},
  {"sheet": "end"},
  {"assert": {"tabs": {"count": 4, "selected": 2}, "textContains": "a draft"}},
  {"close": true},

  {"log": "Search: a query replaces the tree with ranked hits and snippets; Escape clears it"},
  {"notes": {"search": "zebra"}},
  {"assert": {"notes": {"hitsContain": ["Notes"], "rowsLack": ["Archive", "Tags"]}}},
  {"snapshot": "04-search"},
  {"notes": {"search": "alpha"}},
  {"assert": {"notes": {"hitsContain": ["Alpha Project"]}}},
  {"snapshot": "05-search-alpha"},
  {"notes": {"search": "qqqzzzxx"}},
  {"assert": {"notes": {"rows": ["No results"], "hitCount": 0}}},
  {"notes": {"search": "alpha"}},
  {"notes": {"escape": true}},
  {"assert": {"notes": {"rowsStart": ["library", "Archive"], "rowsContain": ["Tags"], "hitCount": 0}}},

  {"log": "Tags: selecting some filters the list to the notes that have all of them"},
  {"notes": {"tag": "project"}},
  {"assert": {"notes": {"selectedTags": ["project"], "rowsContain": ["Alpha", "Beta", "Gamma"], "rowsLack": ["Home", "Inbox"]}}},
  {"notes": {"tag": "active"}},
  {"assert": {"notes": {"selectedTags": ["project", "active"], "rowsContain": ["Alpha"], "rowsLack": ["Beta", "Gamma"]}}},
  {"snapshot": "06-tag-filter"},
  {"log": "Per-window sidebars: switching tabs shows the same sidebar, drawn from the same workspace"},
  {"notes": {"probeTabSwitch": {"to": 0}}},
  {"notes": {"probeTabSwitch": {"to": 2}}},
  {"notes": {"clearTags": true}},
  {"assert": {"notes": {"selectedTags": [], "rowsContain": ["Home", "Inbox"]}}},
  {"notes": {"sort": "modified"}},
  {"assert": {"notes": {"sort": "modified"}, "menu": {"View > Sort Notes > By Date Modified": {"state": "on"}, "View > Sort Notes > By Name": {"state": "off"}}}},
  {"notes": {"sort": "name"}},

  {"log": "Backlinks: a panel under the list for the front document; it follows an edit within a second"},
  {"notes": {"click": "Projects/Gamma.md"}},
  {"notes": {"showBacklinks": true}},
  {"notes": {"backlinks": {"of": "Projects/Gamma.md", "contains": ["Alpha Project", "Ideas"], "within": 2}}},
  {"assert": {"notes": {"backlinksShown": true, "backlinksContain": ["Alpha Project", "Ideas"]}}},
  {"snapshot": "07-backlinks"},
  {"notes": {"click": "Inbox.md"}},
  {"select": [0, 0]},
  {"type": "[[Gamma]] "},
  {"notes": {"backlinks": {"of": "Projects/Gamma.md", "contains": ["Inbox"], "lacks": ["Nothing"], "within": 1.0}}},
  {"notes": {"click": "Projects/Gamma.md"}},
  {"assert": {"notes": {"backlinksContain": ["Alpha Project", "Ideas", "Inbox"]}}},
  {"notes": {"clickBacklink": "Inbox"}},
  {"assert": {"selectedText": "[[Gamma]]", "notes": {"documentURLEndsWith": "Inbox.md"}}},
  {"notes": {"showBacklinks": false}},
  {"assert": {"notes": {"backlinksShown": false}}},

  {"log": "The sidebar is not chrome: it stays when typing hides the title bar and the toolbar; focus centring is the editor's"},
  {"setting": {"autoHideChrome": true}},
  {"notes": {"click": "Notes.md"}},
  {"select": [0, 0]},
  {"type": "typing "},
  {"wait": 0.6},
  {"assert": {"chromeVisible": false, "notes": {"sidebarOpaque": true, "sidebarShown": true}}},
  {"snapshot": "08-typing-chrome-hidden"},
  {"setting": {"autoHideChrome": false}},
  {"pointer": "moved"},
  {"viewMode": "source"},
  {"focus": {"on": true, "scope": "paragraph"}},
  {"select": [0, 0]},
  {"type": "\n\nsecond paragraph\n\nthird paragraph"},
  {"wait": 0.5},
  {"assert": {"focusInsets": true, "focusCentred": 2, "notes": {"sidebarShown": true, "sidebarWidth": 240}}},
  {"snapshot": "09-focus-centring"},
  {"focus": {"on": false}},

  {"log": "The sidebar keeps its width when the window is resized and follows the divider, in every window of the group"},
  {"resize": [1100, 800]},
  {"assert": {"notes": {"sidebarWidth": 240, "sidebarShown": true}}},
  {"notes": {"sidebarWidth": 320}},
  {"assert": {"notes": {"sidebarWidth": 320}}},
  {"notes": {"probeTabSwitch": {"to": 0}}},
  {"assert": {"notes": {"sidebarWidth": 320, "sameWorkspace": true}}},
  {"resize": [300, 300]},
  {"assert": {"notes": {"sidebarWidth": 320}}},
  {"resize": [860, 740]},
  {"notes": {"sidebarWidth": 240}},

  {"log": "Many tabs: the strip is the editor pane's width, scrolls there, and never reaches over the sidebar"},
  {"notes": {"click": "Self.md"}},
  {"notes": {"click": "Snippets.md"}},
  {"notes": {"click": "Escapes.md"}},
  {"notes": {"click": "Headings.md"}},
  {"notes": {"click": "Links.md"}},
  {"notes": {"click": "Fifty%.md"}},
  {"notes": {"click": "Why?.md"}},
  {"notes": {"click": "Note- Colon.md"}},
  {"notes": {"click": "plain.txt"}},
  {"notes": {"click": "Café Society.md"}},
  {"notes": {"click": "emoji party.md"}},
  {"notes": {"click": "Æther.md"}},
  {"notes": {"click": "Überblick.md"}},
  {"assert": {"tabs": {"count": 18, "selected": 17, "nativeBarVisible": false}, "notes": {"tabsBeginAtPane": true, "tabInset": 163, "sidebarShown": true}}},
  {"snapshot": "08-many-tabs"},
  {"assert": {"tabs": {"overflow": {"left": true, "right": false}, "chevronsInside": true, "chevronsMatchClipping": true}}},
  {"tabScroll": 0.5},
  {"assert": {"notes": {"tabsBeginAtPane": true}, "tabs": {"overflow": {"left": true, "right": true}, "chevronsInside": true, "chevronsMatchClipping": true}}},
  {"snapshot": "08b-many-tabs-scrolled-to-the-middle"},
  {"tabChevron": "left"},
  {"tabClick": 3},
  {"notes": {"sidebarWidth": 360}},
  {"assert": {"notes": {"tabsBeginAtPane": true, "tabInset": 283}}},
  {"resize": [1200, 700]},
  {"assert": {"notes": {"tabsBeginAtPane": true}}},
  {"notes": {"sidebarWidth": 240}},
  {"resize": [860, 740]},
  {"assert": {"notes": {"tabsBeginAtPane": true, "tabInset": 163}}},

  {"log": "Notes mode off again: every window of the group is a plain window, nothing else changed"},
  {"notes": {"mode": false}},
  {"assert": {"notes": {"mode": false, "sidebarShown": false, "plainLayout": true, "tabInset": 0, "tabStripWidthIsTheWindows": true, "tabsBeginAtPane": true}, "tabs": {"stripShown": true, "nativeBarVisible": false}}},
  {"snapshot": "08c-many-tabs-plain"},
  {"snapshot": "08-plain-again"},
  {"notes": {"mode": true}},
  {"assert": {"notes": {"mode": true, "sidebarShown": true}}},

  {"log": "The setting opens new windows in notes mode, over the same library"},
  {"notes": {"setting": {"notesModeByDefault": true}}},
  {"new": true},
  {"wait": 0.5},
  {"notes": {"waitLoaded": 30}},
  {"assert": {"notes": {"mode": true, "sidebarShown": true, "rowsStart": ["library", "Archive"], "library": {"noteCount": 34}}}},
  {"snapshot": "10-new-window-in-notes-mode"},
  {"close": true},
  {"notes": {"setting": {"notesModeByDefault": false}}},
  {"new": true},
  {"assert": {"notes": {"mode": false, "plainLayout": true}}},
  {"close": true}
]
