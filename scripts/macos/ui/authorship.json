[
 {
  "log": "--- Authorship: Paste As, Mark As, typing inside borrowed text, bold, undo, save and reopen"
 },
 {
  "setting": {
   "theme": "light",
   "fontChoice": "iaQuattro",
   "fontSize": 17,
   "lineWidth": 72,
   "autoHideChrome": false,
   "spellCheck": false,
   "showFormattingToolbar": true,
   "authorName": "Steve",
   "authorshipDisplay": true
  }
 },
 {
  "open": "scripts/macos/ui/fixtures/authorship.md"
 },
 {
  "resize": [
   900,
   1000
  ]
 },
 {
  "viewMode": "source"
 },
 {
  "waitStyled": 20
 },
 {
  "assert": {
   "authorship": {
    "marks": false,
    "display": true,
    "markRuns": 0
   },
   "edited": false
  }
 },
 {
  "selectText": "PASTE_AI_HERE"
 },
 {
  "setPasteboard": "The Fresnel lens concentrates the light of a lamp into a narrow beam, which is why a lighthouse can be seen from many miles away. It was invented in 1822."
 },
 {
  "action": "pasteAsAI:"
 },
 {
  "waitStyled": 20
 },
 {
  "wait": 0.2
 },
 {
  "assert": {
   "authorship": {
    "runs": [
     [
      "Fresnel lens",
      "ai"
     ],
     [
      "It was invented in 1822",
      "ai"
     ],
     [
      "I wrote this paragraph myself",
      "none"
     ]
    ],
    "marks": true,
    "markRuns": 1
   },
   "colors": {
    "Fresnel lens": "author-ai",
    "I wrote this paragraph myself": "none"
   },
   "overlayConsistent": true,
   "edited": true
  }
 },
 {
  "snapshot": "01-paste-as-ai",
  "bitmap": true
 },
