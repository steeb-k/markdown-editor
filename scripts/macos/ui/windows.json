[
  {"log": "--- One document per window: no tabs, no tab items in any menu, the title in the title bar again"},
  {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72, "autoHideChrome": false, "spellCheck": false, "showFormattingToolbar": true}},
  {"open": "scripts/macos/ui/fixtures/tour.md", "folder": true},
  {"resize": [1000, 680]},
  {"waitStyled": 20},
  {"wait": 0.4},
  {"assert": {"windows": {"count": 1, "titles": ["tour.md"], "documents": 1, "tabbingDisallowed": true, "titleShown": true, "title": "tour.md"}, "titlebarClean": true,
              "menu": {"Window > Merge All Windows": {"absent": true}, "Window > Show Tab Bar": {"absent": true}, "Window > Show Next Tab": {"absent": true},
                       "Window > Move Tab to New Window": {"absent": true}, "File > New Tab": {"absent": true}, "File > Revert To": {"absent": true},
                       "View > Show History": {"enabled": true, "state": "off"}}}},
  {"snapshot": "01-one-window", "bitmap": true},
  {"open": "scripts/macos/ui/fixtures/focus.md", "folder": true},
  {"open": "scripts/macos/ui/fixtures/live.md", "folder": true},
  {"wait": 0.4},
  {"assert": {"windows": {"count": 3, "documents": 3, "titles": ["live.md", "focus.md", "tour.md"], "tabbingDisallowed": true}, "titlebarClean": true}},
  {"snapshot": "02-three-windows", "bitmap": true},
  {"log": "A double-click on the title bar still does what System Settings says, with the title in it"},
  {"doubleClickTitlebar": {"x": 0.96}},
  {"assert": {"windows": {"count": 3}, "titlebarClean": true}},
  {"doubleClickTitlebar": {"x": 0.96}},
  {"log": "Closing a window closes its document, and the others stay"},
  {"close": true},
  {"close": true},
  {"assert": {"windows": {"count": 1, "documents": 1, "titles": ["tour.md"]}}},
  {"remember": "start"},

  {"log": "--- Notes mode: the sidebar replaces the window's document, in the same window"},
  {"notes": {"library": "scripts/macos/ui/fixtures/library"}},
  {"notes": {"mode": true}},
  {"notes": {"waitLoaded": 30}},
  {"wait": 0.4},
  {"remember": "start"},
  {"assert": {"windows": {"count": 1, "titles": ["tour.md"], "titleShown": true}, "titlebarClean": true, "notes": {"sidebarShown": true, "ownWorkspace": true}}},
  {"snapshot": "03-notes-mode-with-title", "bitmap": true},
  {"notes": {"expand": "Projects"}},
  {"notes": {"click": "Projects/Alpha.md"}},
  {"assert": {"windows": {"count": 1, "titles": ["Alpha.md"], "documents": 1, "frameKept": "start", "titleShown": true, "title": "Alpha.md"},
              "titlebarClean": true, "textContains": "# Alpha Project",
              "notes": {"selected": ["Projects/Alpha.md"], "rowsContain": ["Alpha", "Beta"], "ownWorkspace": true}}},
  {"notes": {"click": "Home.md"}},
  {"assert": {"windows": {"count": 1, "titles": ["Home.md"], "documents": 1, "frameKept": "start"}, "notes": {"selected": ["Home.md"], "rowsContain": ["Alpha", "Beta"]}}},
  {"log": "The window keeps what it was showing: the layout, the mode, the column"},
  {"viewMode": "live"},
  {"layout": "split"},
  {"outline": {"show": true}},
  {"notes": {"click": "Projects/Alpha.md"}},
  {"assert": {"windows": {"count": 1, "titles": ["Alpha.md"], "frameKept": "start"}, "outline": {"shown": true}}},
  {"wait": 0.5},
  {"assert": {"menu": {"View > Live": {"state": "on"}, "View > Editor and Preview": {"state": "on"}, "View > Show Outline": {"state": "on"}}}},
  {"snapshot": "04-replaced-keeps-layout", "bitmap": true},
  {"outline": {"show": false}},
  {"layout": "editor"},
  {"viewMode": "source"},

  {"log": "--- Command-click opens a window of its own, with a copy of the sidebar's state"},
  {"notes": {"click": "Home.md", "command": true}},
  {"assert": {"windows": {"count": 2, "titles": ["Home.md", "Alpha.md"], "documents": 2},
              "notes": {"selected": ["Home.md"], "rowsContain": ["Alpha", "Beta"], "ownWorkspace": true, "sidebarShown": true}, "titlebarClean": true}},
  {"snapshot": "05-new-window", "bitmap": true},
  {"notes": {"sidebarWidth": 320}},
  {"assert": {"notes": {"sidebarWidth": 320}}},
  {"switchTo": 0},
  {"assert": {"notes": {"sidebarWidth": 240, "selected": ["Projects/Alpha.md"], "ownWorkspace": true}, "windows": {"titles": ["Alpha.md", "Home.md"]}}},
  {"log": "Two windows on one library: a note made in one shows in the other's sidebar"},
  {"notes": {"newNote": true}},
  {"notes": {"commitRename": "Zed"}},
  {"notes": {"settle": 10}},
  {"assert": {"windows": {"count": 2, "titles": ["Zed.md", "Home.md"]}, "notes": {"rowsContain": ["Zed"]}}},
  {"switchTo": 0},
  {"assert": {"windows": {"count": 2}}},

  {"log": "A note that is open in another window comes forward instead of opening twice"},
  {"notes": {"click": "Home.md"}},
  {"assert": {"windows": {"count": 2, "titles": ["Home.md", "Zed.md"], "documents": 2}, "notes": {"documentURLEndsWith": "Home.md"}}},

  {"log": "A wikilink replaces the window's document; Command-Option-click opens it in a window of its own"},
  {"notes": {"click": "Links.md"}},
  {"assert": {"windows": {"count": 2, "titles": ["Links.md", "Zed.md"]}}},
  {"notes": {"cmdClickWikilink": "Gamma", "expect": "open"}},
  {"assert": {"windows": {"count": 2, "titles": ["Gamma.md", "Zed.md"]}, "notes": {"documentURLEndsWith": "Projects/Gamma.md", "selected": ["Projects/Gamma.md"]}}},
  {"notes": {"click": "Links.md"}},
  {"notes": {"cmdClickWikilink": "Gamma", "expect": "open", "newWindow": true}},
  {"assert": {"windows": {"count": 3, "titles": ["Gamma.md", "Links.md", "Zed.md"], "documents": 3}, "notes": {"documentURLEndsWith": "Projects/Gamma.md"}}},
  {"snapshot": "06-three-windows-notes", "bitmap": true},

  {"log": "Quick Open and Today's Note replace the document too; Command-Return opens a window"},
  {"action": "quickOpen:", "edits": false},
  {"palette": {"type": "inbox"}},
  {"palette": {"choose": true}},
  {"assert": {"windows": {"count": 3, "titles": ["Inbox.md", "Links.md", "Zed.md"]}}},
  {"notes": {"todaysNote": true}},
  {"assert": {"windows": {"count": 3, "titles": ["$TODAY.md", "Links.md", "Zed.md"]}, "notes": {"documentURLEndsWith": "Daily/$TODAY.md"}}},

  {"log": "Closing the windows one by one leaves the others with their sidebars"},
  {"close": true},
  {"assert": {"windows": {"count": 2, "documents": 2}, "notes": {"sidebarShown": true}}},
  {"close": true},
  {"assert": {"windows": {"count": 1, "documents": 1}, "notes": {"sidebarShown": true, "ownWorkspace": true}}}
]
