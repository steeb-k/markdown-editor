[
 {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72, "autoHideChrome": false, "defaultTemplate": "Default"}},

 {"log": "Format > Template on an empty document: one undo step each way"},
 {"makeFile": {"name": "empty.md", "text": ""}},
 {"waitStyled": 20},
 {"template": "Academic"},
 {"assert": {"textEquals": "---\ntemplate: Academic\n---\n", "template": {"effective": "Academic", "frontMatter": "Academic", "menuChecked": "Academic"}}},
 {"undo": true},
 {"assert": {"textEquals": "", "template": {"effective": "Default", "frontMatter": "", "menuChecked": "Default template"}}},
 {"redo": true},
 {"assert": {"textEquals": "---\ntemplate: Academic\n---\n", "template": {"effective": "Academic"}}},
 {"template": ""},
 {"assert": {"textEquals": ""}},
 {"close": true},

 {"log": "CRLF and a byte order mark: the editor holds LF, the file keeps both"},
 {"makeFile": {"name": "crlf.md", "text": "# Title\r\n\r\nBody\r\n", "bom": true}},
 {"waitStyled": 20},
 {"template": "Letter"},
 {"assert": {"textEquals": "---\ntemplate: Letter\n---\n\n# Title\n\nBody\n", "template": {"effective": "Letter"}}},
 {"save": true},
 {"assert": {"documentFile": {"contains": "---\r\ntemplate: Letter\r\n---\r\n\r\n# Title\r\n\r\nBody\r\n", "lacks": "Letter\n"}}},
 {"close": true},

 {"log": "Odd YAML for the key"},
 {"makeFile": {"name": "quoted.md", "text": "---\ntemplate: \"Academic\"\n---\n\n# A\n"}},
 {"waitStyled": 20},
 {"assert": {"template": {"effective": "Academic", "frontMatter": "Academic", "menuChecked": "Academic"}}},
 {"close": true},
 {"makeFile": {"name": "single.md", "text": "---\ntemplate: 'academic'\n---\n\n# A\n"}},
 {"waitStyled": 20},
 {"assert": {"template": {"effective": "Academic", "frontMatter": "academic", "menuChecked": "Academic"}}},
 {"template": "Academic"},
 {"assert": {"textContains": "template: Academic\n", "textLacks": "'academic'"}},
 {"close": true},
 {"makeFile": {"name": "spaced.md", "text": "---\ntemplate:    Academic    \n---\n\n# A\n"}},
 {"waitStyled": 20},
 {"assert": {"template": {"effective": "Academic", "frontMatter": "Academic"}}},
 {"template": "Academic"},
 {"assert": {"textContains": "template:    Academic    \n"}},
 {"close": true},
 {"makeFile": {"name": "capital.md", "text": "---\nTemplate: Academic\n---\n\n# A\n"}},
 {"waitStyled": 20},
 {"assert": {"template": {"effective": "Default", "frontMatter": "", "menuChecked": "Default template"}}},
 {"close": true},
 {"makeFile": {"name": "twice.md", "text": "---\ntemplate: Letter\ntemplate: Academic\n---\n\n# A\n"}},
 {"waitStyled": 20},
 {"assert": {"template": {"effective": "Letter", "frontMatter": "Letter"}}},
 {"template": "Typewriter"},
 {"assert": {"textContains": "template: Typewriter\ntemplate: Academic\n", "template": {"effective": "Typewriter"}}},
 {"close": true},
 {"makeFile": {"name": "dots.md", "text": "---\ntitle: T\n...\n\n# A\n"}},
 {"waitStyled": 20},
 {"template": "Academic"},
 {"assert": {"textEquals": "---\ntitle: T\ntemplate: Academic\n...\n\n# A\n", "template": {"effective": "Academic"}}},
 {"close": true},
 {"makeFile": {"name": "only.md", "text": "---\ntemplate: Academic\n---"}},
 {"waitStyled": 20},
 {"assert": {"template": {"effective": "Academic"}}},
 {"template": ""},
 {"assert": {"textEquals": ""}},
 {"close": true},

 {"log": "A document that opens with a thematic break: the key is not written into its text"},
 {"makeFile": {"name": "rule.md", "text": "---\n\nIntro.\n\n---\n\nBody\n"}},
 {"waitStyled": 20},
 {"layout": "split"},
 {"waitPreview": 30},
 {"template": "Academic"},
 {"waitPreview": 30},
 {"assert": {"textEquals": "---\ntemplate: Academic\n---\n\n---\n\nIntro.\n\n---\n\nBody\n",
             "template": {"effective": "Academic", "previewUses": "Academic"},
             "preview": {"lacks": "template: Academic", "contains": "Intro."}}},
 {"template": ""},
 {"assert": {"textEquals": "---\n\nIntro.\n\n---\n\nBody\n"}},
 {"close": true},

 {"log": "The default template setting naming one that is not installed"},
 {"setting": {"defaultTemplate": "Gone"}},
 {"open": "scripts/macos/ui/fixtures/template-plain.md", "folder": true},
 {"waitStyled": 20},
 {"layout": "split"},
 {"waitPreview": 30},
 {"assert": {"template": {"effective": "Default", "menuChecked": "Default template", "previewUses": "Default"}, "preview": {"styleLacks": "Charter"}}},
 {"close": true},
 {"setting": {"defaultTemplate": "Default"}},

 {"log": "Preview layout: a new template restyles the page in place, scrolled where it was"},
 {"open": "scripts/macos/ui/fixtures/preview-tour.md", "folder": true},
 {"resize": [1100, 700]},
 {"waitStyled": 20},
 {"layout": "preview"},
 {"waitPreview": 30},
 {"previewScroll": 0.5},
 {"evalPreview": "window.__kept = 'same page'; window.__y = window.scrollY; return String(window.scrollY > 50);", "expect": "true"},
 {"template": "Academic"},
 {"waitPreview": 30},
 {"wait": 0.5},
 {"assert": {"template": {"effective": "Academic", "previewUses": "Academic"}, "preview": {"styleContains": "Charter", "scrolled": true}}},
 {"evalPreview": "return String(window.__kept);", "expect": "same page"},
 {"evalPreview": "return String(Math.abs(window.scrollY - window.__y) < window.innerHeight);", "expect": "true"},
 {"template": "Typewriter"},
 {"waitPreview": 30},
 {"evalPreview": "return String(window.__kept);", "expect": "same page"},
 {"undo": true},
 {"undo": true},
 {"waitPreview": 30},
 {"assert": {"template": {"effective": "Default", "previewUses": "Default"}, "preview": {"styleLacks": "Charter"}, "textLacks": "template:"}},
 {"evalPreview": "return String(window.__kept);", "expect": "same page"},
 {"close": true},

 {"log": "PDF with Academic: the template's stylesheet and its numbered headings"},
 {"makeFile": {"name": "numbered.md", "text": "---\ntemplate: Academic\n---\n\n# Introduction\n\nText.\n\n## Method\n\nMore.\n\n### Detail\n\nMost.\n\n# Results\n\nEnd.\n"}},
 {"waitStyled": 20},
 {"exportPDF": "academic.pdf"},
 {"assert": {"pdf": {"file": "academic.pdf", "minPages": 1, "contains": ["Introduction", "1.1", "1.1.1", "2. Results"], "light": true}}},
 {"template": "Default"},
 {"exportPDF": "default.pdf"},
 {"assert": {"pdf": {"file": "default.pdf", "contains": ["Introduction", "Results"], "lacks": ["1.1", "2. Results"]}}},
 {"close": true}
]
