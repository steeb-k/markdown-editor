[
 {"setting": {"theme": "light", "fontChoice": "iaQuattro", "fontSize": 17, "lineWidth": 72, "autoHideChrome": false, "defaultTemplate": "Default"}},
 {"open": "scripts/macos/ui/fixtures/template-plain.md", "folder": true},
 {"waitStyled": 20},

 {"log": "Import: a bundle (its CSS holding </style>) and a stylesheet"},
 {"templatesWindow": "show"},
 {"templates": {"import": "scripts/macos/ui/fixtures/templates/Paper.iatemplate"}},
 {"assert": {"templates": {"selected": "Paper", "readOnly": false, "customCSS": true,
                           "sampleStyleContains": ["/* paper-style */", "/* paper-title", "letter-spacing: 2px"]}}},
 {"templates": {"import": "scripts/macos/ui/fixtures/templates/Noir.css"}},
 {"assert": {"templates": {"selected": "Noir", "customCSS": true, "sampleStyleContains": "/* noir */",
                           "list": ["Academic", "Default", "Letter", "Typewriter", "Noir", "Paper"]}}},
 {"snapshot": "noir", "window": "templates"},

 {"log": "Export as a folder and as a zip, and both import again"},
 {"templates": {"select": "Paper"}},
 {"templates": {"export": "out:export/Paper.mdtemplate"}},
 {"templates": {"export": "out:export/Paper.mdtemplate.zip", "zipped": true}},
 {"templates": {"import": "out:export/Paper.mdtemplate.zip"}},
 {"assert": {"templates": {"selected": "Paper 2", "customCSS": true, "sampleStyleContains": "/* paper-style */"}}},
 {"templates": {"import": "out:export/Paper.mdtemplate"}},
 {"assert": {"templates": {"selected": "Paper 3", "customCSS": true}}},

 {"log": "Rename in place: a real double-click on the row, the name typed, Return"},
 {"templates": {"new": true}},
 {"assert": {"templates": {"selected": "Untitled"}}},
 {"templates": {"renameInline": "Mine"}},
 {"assert": {"templates": {"selected": "Mine"}}},
 {"templates": {"renameInline": "academic", "expect": "academic 2"}},
 {"templates": {"renameInline": "Something", "end": "escape"}},
 {"templates": {"renameInline": "", "expect": "academic 2"}},
 {"assert": {"templates": {"selected": "academic 2",
                           "list": ["Academic", "Default", "Letter", "Typewriter", "academic 2", "Noir", "Paper", "Paper 2", "Paper 3"]}}},
 {"templates": {"element": "h1"}},
 {"templates": {"set": {"weight": 900}}},
 {"wait": 0.8},
 {"assert": {"templates": {"saved": {"weight": 900}}}},

 {"log": "A template a document has chosen is deleted: the menu says so, the preview falls back"},
 {"layout": "split"},
 {"waitPreview": 30},
 {"template": "academic 2"},
 {"waitPreview": 30},
 {"assert": {"template": {"effective": "academic 2", "previewUses": "academic 2", "menuChecked": "academic 2"}, "preview": {"styleContains": "font-weight: 900"}}},
 {"templatesWindow": "show"},
 {"templates": {"select": "academic 2"}},
 {"templates": {"delete": true}},
 {"waitPreview": 30},
 {"wait": 0.3},
 {"assert": {"template": {"effective": "Default", "frontMatter": "academic 2", "previewUses": "Default", "menuChecked": "Default template",
                          "menuHas": ["academic 2 (not installed)"]},
             "preview": {"styleLacks": "font-weight: 900"}}},
 {"undo": true},
 {"assert": {"textLacks": "template:"}},

 {"log": "Dark: the app's appearance and the sample's own switch"},
 {"setting": {"theme": "system"}},
 {"appearance": "dark"},
 {"templatesWindow": "show"},
 {"templates": {"select": "Academic"}},
 {"assert": {"templates": {"theme": "dark", "sampleStyleContains": "color-scheme: dark"}}},
 {"snapshot": "academic-dark", "window": "templates"},
 {"templates": {"appearance": "light"}},
 {"assert": {"templates": {"theme": "light"}}},
 {"appearance": "light"},
 {"setting": {"theme": "light"}},
 {"close": true}
]
