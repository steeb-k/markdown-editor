 },
 {
  "log": "--- a posted click still reaches the window that ignores the real mouse, and the window still ignores it after"
 },
 {
  "scroll": "top"
 },
 {
  "click": {
   "needle": "The quiet page",
   "offset": 4,
   "expectHitIn": "text",
   "expectResponder": "text"
  }
 },
 {
  "assert": {
   "harnessWindows": true
  }
 },
 {
  "log": "--- settings and tabs"
 },
 {
  "settingsWindow": "show"
 },
 {
  "wait": 0.5
 },
 {
  "snapshot": "20-settings",
  "window": "settings"
 },
 {
  "assert": {
   "harnessWindows": true
  }
 },
 {
  "settingsWindow": "hide"
 },
 {
  "new": true
 },
 {
  "wait": 0.5
 },
 {
  "type": "# New tab\n\nSome text."
 },
 {
  "waitStyled": 10
 },
 {
  "snapshot": "21-new-tab"
 },
 {
  "log": "--- closing frees everything"
 },
 {
  "close": true
 },
 {
  "switchTo": 0
 },
 {
  "assert": {
   "coreMatchesText": true
  }
 },
 {
  "close": true
 },
 {
  "assert": {
