 },
 {
  "setting": {
   "fontSize": 22
  }
 },
 {
  "waitStyled": 20
 },
 {
  "assert": {
   "columnCentered": true
  }
 },
 {
  "snapshot": "15-size-22"
 },
 {
  "setting": {
   "fontSize": 17,
   "lineWidth": 50
  }
 },
 {
  "waitStyled": 20
 },
 {
  "assert": {
   "columnCentered": true
  }
 },
 {
  "snapshot": "16-measure-50"
 },
 {
  "setting": {
